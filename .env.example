# fastsite environment — copy to .env for local development.
# In production (Coolify) these come from the environment, never from a file.

APP_ENV=local
# The engine's own public origin (dashboard + API + MCP + OAuth issuer). In
# production set it to the ENGINE host, e.g. https://app.getfastsite.com — the
# public marketing site is a normal published fastsite site served from
# Cloudflare Pages at the apex (getfastsite.com), NOT the engine. See
# docs/domain-split.md.
APP_URL=http://localhost:8080
# Random 64+ char secret. Derives the TokenCipher key and signs sessions.
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Absolute path to the data volume. Defaults to <repo>/var/data when empty.
DATA_PATH=

# Redis (queue + cache). Used from M2 on.
REDIS_URL=tcp://127.0.0.1:6379

# Git identity used for publish commits.
GIT_AUTHOR_NAME=fastsite
GIT_AUTHOR_EMAIL=engine@fastsite.local

# endpointr AI gateway — the OWNER's translation service (private build).
# Translation uses it when configured; leave empty to fall back to each site's
# own OpenRouter credential. This is the ONLY AI config in .env.
# Set this to the gateway HOST ROOT (no /v1). The engine exchanges the key for
# a JWT at {ENDPOINTR_URL}/v1/token, then POSTs to {ENDPOINTR_URL}/v1/ai/chat.
#
# The OpenRouter key for translation-fallback + fact-checking is USER-paid, so
# it is NOT set here — each account adds its own under the dashboard's
# Account → AI keys and selects it per site. Nothing to configure server-side.
ENDPOINTR_URL=https://ai.mcp.endpointr.com
ENDPOINTR_KEY=

# Per-call translation timeout in seconds. A large page's body can take several
# minutes to translate; raise this if you hit "Operation timed out" errors.
# MUST stay below 600 (the queue's stale-job threshold); clamped to [30, 590].
AI_TRANSLATE_TIMEOUT=420
