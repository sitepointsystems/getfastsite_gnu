{% extends 'dash-layout.html.twig' %}

{% block body %}
<div class="head-row">
  <div>
    {% set active_ws = workspaces|filter(w => w.id == current_workspace)|first %}
    <h1 style="margin:0">{{ trash ? 'Trash' : (active_ws ? active_ws.name : 'Sites') }}</h1>
    <p class="sub" style="margin:.3rem 0 0">{{ trash ? 'Deleted sites — recover them, or delete permanently.' : (active_ws ? 'Sites in this workspace only — switch to "All workspaces" in the sidebar to see everything.' : 'Everything you publish through fastsite.') }}</p>
  </div>
  <div>
    {% if trash %}
      <a class="button small ghost" href="/">← Back to sites</a>
    {% else %}
      {% if trash_count %}<a class="button small ghost" href="/?trash=1">Trash ({{ trash_count }})</a>{% endif %}
      {% if user.role in ['admin', 'editor'] %}<a class="button small" href="#new-site" onclick="document.getElementById('new-site').open = true">＋ New site</a>{% endif %}
    {% endif %}
  </div>
</div>

{% if not trash and user.role in ['admin', 'editor'] %}
<details class="card" id="new-site" style="margin-top:1.25rem" {{ cards is empty ? 'open' }}>
  <summary style="font-weight:600;cursor:pointer">New site</summary>
  <form method="post" action="/sites/action" class="row" style="margin-top:.9rem">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="action" value="create-site">
    <div class="tight"><label>Handle <span class="mut">(immutable, e.g. blog)</span></label><input type="text" name="handle" pattern="[a-z0-9][a-z0-9\-]*" placeholder="blog" required></div>
    <div><label>Name</label><input type="text" name="name" placeholder="My blog"></div>
    <div><label>Base URL <span class="mut">(optional now)</span></label><input type="url" name="url" placeholder="https://example.com"></div>
    <div class="tight"><label>Locale</label><input type="text" name="locale" value="en" size="4"></div>
    <div class="tight" style="align-self:end"><button class="button" type="submit">Create</button></div>
  </form>
  <p class="mut" style="font-size:.85rem;margin:.6rem 0 0">Provisions the database and a default shell. Set the domain, repo and go-live options on the site's Settings screen afterwards — and share it with collaborators via a team.</p>
</details>
{% endif %}

{% if cards is empty %}
  <div class="card" style="margin-top:1.25rem">
    {% if trash %}Trash is empty.{% elseif active_ws %}No sites in this workspace yet — move one here from its card's ⋮ menu, or create one above while this workspace is selected. Manage workspaces on the <a href="/workspaces">Workspaces</a> screen.{% elseif user.role in ['admin', 'editor'] %}No sites yet — create one above.{% else %}No sites yet — ask an admin or an editor to give you access.{% endif %}
  </div>
{% endif %}

<div class="cards cards-wide" style="margin-top:1.25rem">
{% for c in cards %}
  <div class="card">
    <a class="card-thumb" href="/sites/{{ c.site.handle }}/preview/" target="_blank" rel="noopener" title="Open preview">
      <img src="/sites/{{ c.site.handle }}/card.png" alt="" loading="lazy" onerror="this.closest('.card-thumb').classList.add('empty')">
      <span class="card-thumb-fallback">{{ c.site.name|slice(0, 1)|upper }}</span>
    </a>
    <h2 style="margin:0 0 .2rem">{{ c.site.name }}</h2>
    <p class="mut" style="margin:0 0 .8rem;font-size:.85rem">
      {# canonicalBaseUrl, not baseUrl: link the host the site actually answers on. #}
      {% if c.site.baseUrl %}<a href="{{ c.site.canonicalBaseUrl }}" rel="noopener" target="_blank">{{ c.site.canonicalBaseUrl }}</a>{% else %}no URL configured{% endif %}
    </p>
    <dl class="kv">
      <dt>Status</dt><dd><span class="badge {{ c.site.status == 'active' ? 'ok' : 'mut' }}">{{ c.site.status }}</span>
        {# The one state worth seeing without opening the site: a site nobody
           remembers is still noindexed looks completely healthy otherwise. #}
        {% if c.site.development %}<span class="badge warn" title="Every page publishes with noindex, nofollow — this site cannot appear in search">in development</span>{% endif %}
      </dd>
      <dt>Content</dt><dd>{{ c.counts.published|default(0) }} published, {{ c.counts.draft|default(0) }} draft</dd>
      <dt>Languages</dt><dd>{{ c.site.primaryLocale }}{% for l in c.site.locales %}, {{ l }}{% endfor %}</dd>
      {% if trash %}
        <dt>Deleted</dt><dd class="mut">{{ c.site.deletedAt }}</dd>
      {% else %}
        <dt>Last build</dt>
        <dd>
          {% if c.last_build %}
            <span class="badge {{ c.last_build.status }}">{{ c.last_build.status }}</span>
            <span class="mut">{{ c.last_build.finished_at ?: '' }}</span>
          {% else %}<span class="mut">never</span>{% endif %}
        </dd>
      {% endif %}
    </dl>
    <div class="card-actions">
    {% if trash %}
      <form method="post" action="/sites/action" class="inline">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="restore-site">
        <input type="hidden" name="handle" value="{{ c.site.handle }}">
        <button class="button small" type="submit">Recover</button>
      </form>
      <form method="post" action="/sites/action" class="inline"
            data-confirm="Permanently delete “{{ c.site.name }}” and all of its files and history? This cannot be undone."
            data-confirm-title="Delete permanently" data-confirm-ok="Delete permanently" data-confirm-danger
            data-confirm-match="{{ c.site.handle }}" data-confirm-match-label="Type the handle “{{ c.site.handle }}” to confirm">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="purge-site">
        <input type="hidden" name="handle" value="{{ c.site.handle }}">
        <input type="hidden" name="confirm_handle" value="" data-confirm-input>
        <button class="button small danger" type="submit">Delete permanently</button>
      </form>
    {% else %}
      <a class="button small" href="/sites/{{ c.site.handle }}/content">Content</a>
      <a class="button small ghost" href="/sites/{{ c.site.handle }}/media">Media</a>
      <a class="button small ghost" href="/sites/{{ c.site.handle }}/files">Files</a>
      <a class="button small ghost" href="/sites/{{ c.site.handle }}/components">Components</a>
      <a class="button small ghost" href="/sites/{{ c.site.handle }}/preview/" target="_blank" rel="noopener">Preview ↗</a>
      <form method="post" action="/sites/{{ c.site.handle }}/content/action" class="inline">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="publish-site">
        <button class="button small" type="submit">Publish</button>
      </form>
      <div class="kebab">
        <button type="button" class="kebab-trigger" data-kebab aria-label="More actions" aria-haspopup="true">⋮</button>
        <div class="kebab-menu">
          <a href="/sites/{{ c.site.handle }}/settings">Settings</a>
          <a href="/sites/{{ c.site.handle }}/webhooks">Webhooks</a>
          {% if c.can_manage and workspaces|length %}
          <div class="ws-move">
            <div class="zone-label">Workspace</div>
            <form method="post" action="/workspaces/action">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="move-site">
              <input type="hidden" name="handle" value="{{ c.site.handle }}">
              <select name="workspace_id" onchange="this.form.submit()" aria-label="Move to workspace">
                <option value="">— none —</option>
                {% for w in workspaces %}<option value="{{ w.id }}" {{ c.site.workspaceId == w.id ? 'selected' }}>{{ w.name }}</option>{% endfor %}
              </select>
            </form>
          </div>
          {% endif %}
          <div class="danger-zone">
            <div class="zone-label">Danger zone</div>
            <form method="post" action="/sites/action"
                  data-confirm="Move “{{ c.site.name }}” to trash? It leaves your sites list but its content and files are kept and can be recovered."
                  data-confirm-title="Move to trash" data-confirm-ok="Move to trash" data-confirm-danger>
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="soft-delete-site">
              <input type="hidden" name="handle" value="{{ c.site.handle }}">
              <button type="submit">Delete</button>
            </form>
          </div>
        </div>
      </div>
    {% endif %}
    </div>
  </div>
{% endfor %}
</div>
<style>
  .head-row{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap}
  .cards-wide{grid-template-columns:repeat(auto-fill,minmax(24rem,1fr))}
  .card-thumb{display:block;position:relative;aspect-ratio:16/10;border-radius:10px;overflow:hidden;border:1px solid var(--border);margin:-.25rem 0 1rem;background:linear-gradient(135deg,var(--bg-2),var(--surface))}
  .card-thumb img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  .card-thumb-fallback{position:absolute;inset:0;display:none;align-items:center;justify-content:center;font-size:2.4rem;font-weight:800;color:var(--muted)}
  .card-thumb.empty img{display:none}
  .card-thumb.empty .card-thumb-fallback{display:flex}
  .card-actions{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1rem;align-items:center}
  .kebab-menu .ws-move{margin-top:.3rem;padding-top:.35rem;border-top:1px solid var(--border)}
  .kebab-menu .ws-move .zone-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding:.1rem .6rem .2rem}
  .kebab-menu .ws-move select{width:100%;padding:.35rem .5rem;font-size:.85rem}
</style>
{% endblock %}
