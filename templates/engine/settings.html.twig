{% extends 'dash-layout.html.twig' %}

{% block body %}
<style>
  /* Custom thumbnail dropdown for favicon/logo pickers (#4B/#31): a styled
     trigger showing the current image, a scrollable thumbnail panel. Field
     names stay favicon_media_id / logo_header_media_id / logo_footer_media_id. */
  .mediadrop{position:relative}
  .mediadrop .opt{width:1.9rem;height:1.9rem;flex:0 0 auto;border-radius:5px;border:1px solid var(--border);background:var(--surface);object-fit:cover;display:inline-flex;align-items:center;justify-content:center;color:var(--muted);font-size:.85rem}
  .mediadrop-trigger{width:100%;display:flex;align-items:center;gap:.55rem;background:var(--bg-2);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:.4rem .6rem;font:inherit;cursor:pointer;text-align:left}
  .mediadrop-trigger:hover{border-color:var(--accent)}
  .mediadrop-current{display:flex;align-items:center;gap:.55rem;flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:.85rem}
  .mediadrop-caret{color:var(--muted);flex:0 0 auto}
  .mediadrop-panel{position:absolute;z-index:20;top:calc(100% + .3rem);left:0;right:0;max-height:16rem;overflow-y:auto;background:var(--surface);border:1px solid var(--border-strong,var(--border));border-radius:8px;box-shadow:0 12px 30px rgba(0,0,0,.4);padding:.3rem}
  .mediadrop-opt{width:100%;display:flex;align-items:center;gap:.55rem;background:none;border:0;color:var(--text-2);padding:.35rem .45rem;border-radius:6px;font:inherit;font-size:.85rem;cursor:pointer;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mediadrop-opt:hover{background:var(--bg-2);color:var(--text)}
</style>
<h1>{{ site.name }}</h1>
<p class="sub">Site settings — shell, languages, components.</p>
{% include 'site-nav.html.twig' %}

<div class="card">
  <h2 style="margin-top:0">Preview</h2>
  <p class="mut" style="font-size:.9rem">View the site in-browser with no deploy. Opening it checks whether anything changed since the last preview — if so it rebuilds (with a progress screen), otherwise it shows the current build straight away. Every internal path is relative, so it renders exactly as it will once published.</p>
  <a class="button" href="/sites/{{ site.handle }}/preview/" target="_blank" rel="noopener">Preview ↗</a>
</div>

<div class="card">
  <details>
    <summary style="font-weight:600;font-size:1.05rem">Authoring guide — how to design this site for 100/100/100/100</summary>
    <p class="mut" style="margin:.6rem 0 1rem;font-size:.88rem">Agents fetch the full guide via the MCP tool <span class="mono">get_authoring_guide</span> or <span class="mono">GET /api/v1/sites/{{ site.handle }}/authoring-guide</span>. Key rules:</p>
    <table>
      <tr><th>Area</th><th>Rule</th><th>What to do</th></tr>
      {% for r in guide_rules %}
      <tr>
        <td class="mut">{{ r.category }}</td>
        <td>{{ r.title }}{% if r.ref %} <a href="{{ r.ref }}" target="_blank" rel="noopener">ref</a>{% endif %}</td>
        <td class="mut">{{ r.applies }}</td>
      </tr>
      {% endfor %}
    </table>
  </details>
</div>

<div class="grid2">
  <div>
    <div class="card">
      <h2 style="margin-top:0">Site details</h2>
      {% if user.role == 'admin' %}
      <form method="post" action="/sites/{{ site.handle }}/settings/action">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="site-save">
        <div class="row">
          <div><label>Name</label><input type="text" name="name" value="{{ site.name }}" required></div>
          <div class="tight"><label>Handle <span class="mut">(immutable)</span></label><input type="text" value="{{ site.handle }}" disabled></div>
        </div>
        <label>Base URL <span class="mut">(apex — a leading www. is stripped automatically)</span></label>
        <input type="url" name="base_url" value="{{ site.baseUrl }}" placeholder="https://example.com">
        <label style="margin-top:1rem">Serving <span class="mut">(how this site goes live — the Go-live card below walks through either path)</span></label>
        <div style="display:grid;gap:.5rem">
          <label style="display:flex;gap:.6rem;align-items:flex-start;margin:0;font-size:.9rem;color:var(--text)">
            <input type="radio" name="serve_mode" value="git" {{ site.serveMode == 'git' ? 'checked' }} style="margin-top:.25rem">
            <span><strong>Git → CDN</strong> <span class="mut">— every publish is pushed to the GitHub repo below; Cloudflare Pages / Netlify deploys it to their edge. Free, global, needs the repo + a one-time CDN hookup.</span></span>
          </label>
          <label style="display:flex;gap:.6rem;align-items:flex-start;margin:0;font-size:.9rem;color:var(--text)">
            <input type="radio" name="serve_mode" value="direct" {{ site.serveMode == 'direct' ? 'checked' }} style="margin-top:.25rem">
            <span><strong>Direct from this server</strong> <span class="mut">— the engine serves the built site itself on <span class="mono">{{ site.primaryDomain ?: 'the base URL domain' }}</span>. No repo or CDN account needed; publishes are live instantly. Requires the base URL and pointing the domain at this server.</span></span>
          </label>
        </div>
        <div class="row" style="margin-top:1rem">
          <div>
            <label>GitHub repo <span class="mut">(the dist repo the build is pushed to)</span></label>
            <input type="text" name="github_repo" value="{{ site.githubRepo }}" placeholder="git@github.com:you/site-dist.git">
          </div>
          <div class="tight"><label>Branch</label><input type="text" name="github_branch" value="{{ site.githubBranch }}" size="10"></div>
        </div>
        <label>Publish with <span class="mut">(a GitHub credential from your Account, or the server's global token — HTTPS repos only)</span></label>
        <select name="github_credential_id">
          <option value="">{{ global_token_configured ? '— global token —' : '— global token (not set on this server) —' }}</option>
          {% for c in github_creds %}<option value="{{ c.id }}" {{ site.githubCredentialId == c.id ? 'selected' }}>#{{ c.id }} {{ c.label }} ({{ c.email }})</option>{% endfor %}
        </select>
        {% if site.serveMode == 'git' and site.githubRepo %}
          {% if site.githubRepo starts with 'https://' and not site.githubCredentialId and not global_token_configured %}
            <p class="flash err" style="font-size:.85rem;margin:.5rem 0 0">Publishing will <strong>fail</strong>: this repo pushes over HTTPS, no credential is selected, and the server has no global <span class="mono">GITHUB_TOKEN</span>. Pick a credential above or add one on your <a href="/account">Account</a>.</p>
          {% elseif site.githubRepo starts with 'git@' and not deploy_key_exists %}
            <p class="flash err" style="font-size:.85rem;margin:.5rem 0 0">This repo pushes over <strong>SSH</strong>, where the credential above is not used — publishing needs a deploy key at <span class="mono">keys/{{ site.handle }}</span> on the data volume (none found). Use an <span class="mono">https://</span> repo URL with a credential instead, or add the key.</p>
          {% endif %}
        {% endif %}
        <label>AI key <span class="mut">(OpenRouter key from an Account — powers translation fallback &amp; fact-checking)</span></label>
        <select name="ai_credential_id">
          <option value="">— none —</option>
          {% for c in ai_credentials %}<option value="{{ c.id }}" {{ site.aiCredentialId == c.id ? 'selected' }}>#{{ c.id }} {{ c.label }} ({{ c.email }})</option>{% endfor %}
        </select>
        <label>Team <span class="mut">(share this site with a team you belong to)</span></label>
        <select name="team_id">
          <option value="">— just me —</option>
          {% for t in user_teams %}<option value="{{ t.id }}" {{ site.teamId == t.id ? 'selected' }}>{{ t.name }}</option>{% endfor %}
        </select>
        <div class="row">
          <div><label>Media public base <span class="mut">(R2 custom domain, optional)</span></label><input type="url" name="media_public_base" value="{{ site.mediaPublicBase }}" placeholder="https://media.example.com"></div>
          <div class="tight">
            <label>Status</label>
            <select name="status">
              {% for s in ['active', 'paused', 'archived'] %}
                <option value="{{ s }}" {{ site.status == s ? 'selected' }}>{{ s }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <label style="margin-top:1rem">Branding <span class="mut">(pick from the media library — images only)</span></label>
        {% if images|length %}
        <div class="row">
          {% set brandpickers = [
            {name: 'favicon_media_id', label: 'Favicon', sel: site.faviconMediaId, none: 'shell default'},
            {name: 'logo_header_media_id', label: 'Header logo', sel: site.logoHeaderMediaId, none: 'text name'},
            {name: 'logo_footer_media_id', label: 'Footer logo', sel: site.logoFooterMediaId, none: 'none'},
            {name: 'social_image_media_id', label: 'Social share image', sel: site.socialImageMediaId, none: 'none'}
          ] %}
          {% for p in brandpickers %}
          <div>
            <label class="mut" style="font-size:.8rem">{{ p.label }}</label>
            <div class="mediadrop" data-mediadrop>
              <input type="hidden" name="{{ p.name }}" value="{{ p.sel ?: '' }}">
              <button type="button" class="mediadrop-trigger"><span class="mediadrop-current"></span><span class="mediadrop-caret">▾</span></button>
              <div class="mediadrop-panel" hidden>
                <button type="button" class="mediadrop-opt" data-value="" data-thumb=""><span class="opt">∅</span>— {{ p.none }} —</button>
                {% for img in images %}
                <button type="button" class="mediadrop-opt" data-value="{{ img.id }}" data-thumb="/sites/{{ site.handle }}/media/{{ img.id }}/thumb">
                  <img class="opt" src="/sites/{{ site.handle }}/media/{{ img.id }}/thumb" alt="" loading="lazy" onerror="this.style.visibility='hidden'">#{{ img.id }} {{ img.original_name }}
                </button>
                {% endfor %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
        <p class="mut" style="font-size:.8rem;margin:.5rem 0 0">The share image is the og:image / twitter:image used when a page is posted to Facebook, LinkedIn, X or Slack. The 1200&times;630 crop is generated automatically — pick any library image.</p>
        <script>
        (function(){
          document.querySelectorAll('[data-mediadrop]').forEach(function(root){
            if(root.dataset.mdInit) return; root.dataset.mdInit='1';
            var input = root.querySelector('input[type=hidden]');
            var trigger = root.querySelector('.mediadrop-trigger');
            var current = root.querySelector('.mediadrop-current');
            var panel = root.querySelector('.mediadrop-panel');
            var opts = Array.prototype.slice.call(root.querySelectorAll('.mediadrop-opt'));
            function paint(opt){
              current.innerHTML = '';
              var thumb = opt.getAttribute('data-thumb');
              if(thumb){ var im = document.createElement('img'); im.className='opt'; im.src=thumb; im.alt=''; im.onerror=function(){this.style.visibility='hidden'}; current.appendChild(im); }
              else { var sp = document.createElement('span'); sp.className='opt'; sp.textContent='∅'; current.appendChild(sp); }
              current.appendChild(document.createTextNode(' ' + opt.textContent.trim()));
            }
            function selectByValue(v){ var m = opts.filter(function(o){return o.getAttribute('data-value')===String(v);}); paint(m[0] || opts[0]); }
            selectByValue(input.value);
            trigger.addEventListener('click', function(e){ e.preventDefault(); panel.hidden = !panel.hidden; });
            opts.forEach(function(o){ o.addEventListener('click', function(e){ e.preventDefault(); input.value = o.getAttribute('data-value'); paint(o); panel.hidden = true; }); });
            document.addEventListener('click', function(e){ if(!root.contains(e.target)) panel.hidden = true; });
          });
        })();
        </script>
        {% else %}
        <p class="mut" style="font-size:.85rem">Upload images in the <a href="/sites/{{ site.handle }}/media">Media</a> library to pick a favicon or logo.</p>
        {% endif %}
        <label style="margin-top:1rem">Default meta description <span class="mut">(used by the home page, blog index and 404 — and by any post or page with no description or excerpt of its own)</span></label>
        <textarea name="meta_description" rows="2" maxlength="320" placeholder="One sentence describing the site. Around 150 characters reads best in search results.">{{ site.metaDescription }}</textarea>

        <label style="margin-top:1rem">Canonical host <span class="mut">(www ↔ apex 301 is a Cloudflare zone rule; this stores the preference + guidance)</span></label>
        <select name="canonical_host">
          <option value="apex" {{ site.canonicalHost == 'apex' ? 'selected' }}>apex — example.com (recommended)</option>
          <option value="www" {{ site.canonicalHost == 'www' ? 'selected' }}>www — www.example.com</option>
        </select>

        <label style="margin-top:1rem">ShortPixel API key <span class="mut">(optional — your own key + credits for image optimization)</span></label>
        <div class="row">
          <div><input type="password" name="shortpixel_key" autocomplete="off" placeholder="{{ site.shortpixelKeyEnc ? '•••••••• (saved — leave blank to keep)' : 'paste your ShortPixel key' }}"></div>
          {% if site.shortpixelKeyEnc %}<div class="tight" style="align-self:end"><label style="margin:0;font-size:.82rem"><input type="checkbox" name="shortpixel_clear" value="1"> remove</label></div>{% endif %}
        </div>

        <label style="margin-top:1rem">Image sizes <span class="mut">(caps how large uploaded images are served)</span></label>
        <div class="row">
          <div><label class="mut" style="font-size:.8rem">Max image width (px)</label><input type="number" name="image_max_width" min="480" max="4096" step="1" value="{{ site.imageMaxWidth }}"></div>
          <div><label class="mut" style="font-size:.8rem">Logo width (px)</label><input type="number" name="logo_max_width" min="64" max="1024" step="1" value="{{ site.logoMaxWidth }}"></div>
        </div>
        <p class="mut" style="font-size:.8rem;margin:.3rem 0 0">The largest responsive variant is capped at Max image width (a 4000px upload won't ship at 4000px). The header/footer logo is served at ~Logo width. Takes effect on the next upload; re-upload existing images to re-encode.</p>

        <label style="margin-top:1rem"><input type="checkbox" name="fact_check_enabled" value="1" {{ site.factCheckEnabled ? 'checked' }}> Enable AI fact-checking <span class="mut">(Perplexity-backed; on-demand from the content editor / API / MCP)</span></label>
        <p class="mut" style="font-size:.83rem;margin:.9rem 0 0">
          Changing the repo resets the local clone so the next publish targets the new remote.
          Changing the name, base URL or branding republishes the site (canonical URLs, sitemap, llms.txt, the robots banner and the favicon/logo all embed them).
        </p>
        <p style="margin:1rem 0 0"><button class="button" type="submit">Save site settings</button></p>
      </form>
      {% else %}
        <dl class="kv">
          <dt>Name</dt><dd>{{ site.name }}</dd>
          <dt>Handle</dt><dd class="mono">{{ site.handle }}</dd>
          <dt>Base URL</dt><dd>{{ site.baseUrl ?: '—' }}</dd>
          <dt>Repo</dt><dd class="mono">{{ site.githubRepo ?: 'not set' }}</dd>
          <dt>Status</dt><dd>{{ site.status }}</dd>
        </dl>
        <p class="mut" style="font-size:.85rem">Only administrators can change these.</p>
      {% endif %}
    </div>

    {% if user.role == 'admin' %}
    <div class="card">
      <h2 style="margin-top:0">Go live</h2>
      <p class="mut" style="font-size:.88rem;margin-bottom:.4rem">Attach <span class="mono">{{ site.primaryDomain ?: 'your domain' }}</span> to the serving mode chosen above. Each path is a few minutes, once.</p>

      <details {{ site.serveMode == 'git' ? 'open' }}>
        <summary style="font-weight:600;font-size:1.02rem">Cloudflare Pages <span class="mut" style="font-weight:400">(Git → CDN)</span></summary>
        <div style="margin-top:.8rem">
          <p class="mut" style="font-size:.86rem;margin:0 0 .5rem"><strong>Automatic:</strong> paste an API token and the engine creates the Pages project from your repo, attaches the domain, and adds the DNS (when the zone is on your account). The one-time GitHub connection is the single click Cloudflare requires from you — the result message links straight to it if it's missing.</p>
          <form method="post" action="/sites/{{ site.handle }}/settings/action" class="row">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="action" value="cf-pages-setup">
            <div><input type="password" name="cf_api_token" autocomplete="off" placeholder="{{ site.cfApiTokenEnc ? '•••••••• (saved — leave blank to reuse)' : 'paste a Cloudflare API token' }}"></div>
            <div class="tight" style="align-self:end"><button class="button" type="submit" data-busy="Talking to Cloudflare…">Set up Cloudflare Pages</button></div>
            <div class="tight" style="align-self:end"><button type="button" class="button ghost small" data-modal-open="#cf-token-help">How do I get the token?</button></div>
            {% if site.cfApiTokenEnc %}<div class="tight" style="align-self:end"><label style="margin:0;font-size:.82rem"><input type="checkbox" name="cf_clear" value="1"> remove token</label></div>{% endif %}
          </form>
          <dialog id="cf-token-help" class="modal">
            <div class="m-head"><h3>How to get the Cloudflare API token</h3></div>
            <div class="m-body m-scroll" style="font-size:.9rem;line-height:1.7">
              <ol style="margin:.2rem 0 0;padding-left:1.3rem">
                <li>Open <a href="https://dash.cloudflare.com/profile/api-tokens" target="_blank" rel="noopener"><strong>dash.cloudflare.com/profile/api-tokens</strong></a> — that link goes straight to <span class="mut">My Profile → API Tokens</span> (log in if asked).</li>
                <li>Click <strong>Create Token</strong>, scroll to the bottom, and under <strong>Custom token</strong> click <strong>Get started</strong>.</li>
                <li>Name it anything, e.g. <span class="mono">fastsite</span>.</li>
                <li>Under <strong>Permissions</strong>, add these three rows (use <strong>+ Add more</strong>):
                  <ul style="margin:.2rem 0;padding-left:1.2rem">
                    <li><span class="mono">Account · Cloudflare Pages · Edit</span></li>
                    <li><span class="mono">Zone · Zone · Read</span></li>
                    <li><span class="mono">Zone · DNS · Edit</span></li>
                  </ul>
                </li>
                <li>Under <strong>Account Resources</strong> pick your account; under <strong>Zone Resources</strong> pick <strong>All zones</strong> (or just <span class="mono">{{ site.primaryDomain ?: 'your domain' }}</span> if the domain is already on Cloudflare).</li>
                <li>Click <strong>Continue to summary</strong> → <strong>Create Token</strong>.</li>
                <li>Copy the token — Cloudflare shows it <em>only once</em> — paste it in the field here, and click <strong>Set up Cloudflare Pages</strong>.</li>
              </ol>
              <p class="mut" style="font-size:.84rem;margin:.8rem 0 0">The token is stored encrypted and only used to talk to Cloudflare on your behalf. You can revoke it any time on the same API Tokens page.</p>
            </div>
            <div class="m-actions">
              <a class="button ghost small" href="https://dash.cloudflare.com/profile/api-tokens" target="_blank" rel="noopener">Open Cloudflare API Tokens ↗</a>
              <button type="button" class="button small" data-modal-close>Close</button>
            </div>
          </dialog>
          <details style="margin-top:.8rem">
            <summary style="cursor:pointer;font-size:.86rem">Or click through it manually</summary>
            {# With the account ID saved the links open the user's account directly;
               without it, Cloudflare's :account placeholder resolves after login
               (and asks which account, if they have several). #}
            {% set cf_dash = site.cfAccountId
              ? 'https://dash.cloudflare.com/' ~ site.cfAccountId
              : 'https://dash.cloudflare.com/?to=/:account' %}
            <div style="margin:.6rem 0 .2rem">
              <form method="post" action="/sites/{{ site.handle }}/settings/action" class="row">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="cf-account-id">
                <div>
                  <label style="margin-top:0">Cloudflare account ID <span class="mut">(makes the links below open your account directly)</span></label>
                  <input type="text" name="cf_account_id" value="{{ site.cfAccountId }}" placeholder="32-character ID — or paste any dash.cloudflare.com URL" autocomplete="off" spellcheck="false" class="mono">
                </div>
                <div class="tight" style="align-self:end"><button class="button" type="submit">Save</button></div>
              </form>
              <details style="margin-top:.3rem">
                <summary class="mut" style="cursor:pointer;font-size:.82rem">Where do I find my account ID?</summary>
                <ol class="mut" style="font-size:.82rem;margin:.4rem 0 0;padding-left:1.2rem;line-height:1.7">
                  <li>Log in at <a href="https://dash.cloudflare.com" target="_blank" rel="noopener">dash.cloudflare.com</a>.</li>
                  <li>Look at the address bar: the URL becomes <span class="mono">dash.cloudflare.com/<strong>&lt;your-account-id&gt;</strong>/…</span> — copy the whole URL and paste it here, the ID is extracted automatically.</li>
                  <li>Or open any domain's <strong>Overview</strong> page: the right sidebar shows <strong>Account ID</strong> with a copy button.</li>
                </ol>
                <p class="mut" style="font-size:.82rem;margin:.4rem 0 0">Running the automatic setup above also stores it for you.</p>
              </details>
            </div>
            <ol class="mut" style="font-size:.86rem;margin:.6rem 0 0;padding-left:1.2rem;line-height:1.7">
              <li>Set the GitHub repo + branch above, Save, and publish once so the repo has content.</li>
              <li>Open <a href="{{ cf_dash }}/pages/new/provider/github" target="_blank" rel="noopener">Cloudflare → create a Pages project from GitHub</a>{{ site.cfAccountId ? '' : ' (logs you in and lands on the right screen)' }}.</li>
              <li>Connect GitHub if asked (one-time), pick the repo.</li>
              <li>Build settings: Framework preset <strong>None</strong>, build command <strong>empty</strong>, output directory <strong>/</strong> → Save and Deploy.</li>
              <li>Open <a href="{{ cf_dash }}/pages/view/{{ cf_project }}/domains" target="_blank" rel="noopener">the project's Custom domains screen</a> → <strong>Set up a domain</strong> → add <span class="mono">{{ site.primaryDomain ?: 'example.com' }}</span> — Cloudflare shows the exact CNAME to add. <span class="mut">(Link assumes the project is named <span class="mono">{{ cf_project }}</span> — if you picked another name, use the project list.)</span></li>
              <li>Optional: a zone <em>Redirect Rule</em> for www → apex.</li>
            </ol>
            <p class="mut" style="font-size:.82rem;margin:.6rem 0 0">Netlify works the same way: import the repo, no build step, publish directory <span class="mono">/</span>.</p>
          </details>
        </div>
      </details>

      <details style="margin-top:.8rem" {{ site.serveMode == 'direct' ? 'open' }}>
        <summary style="font-weight:600;font-size:1.02rem">Direct from this server</summary>
        <ol class="mut" style="font-size:.86rem;margin:.8rem 0 0;padding-left:1.2rem;line-height:1.7">
          <li>DNS: add an <strong>A</strong> (and <strong>AAAA</strong> if you have IPv6) record for <span class="mono">{{ site.primaryDomain ?: 'example.com' }}</span> <em>and</em> <span class="mono">www.{{ site.primaryDomain ?: 'example.com' }}</span> pointing at this server's IP (Coolify → your server shows it).</li>
          <li>In Coolify: open the fastsite app → <strong>Domains</strong> → add <span class="mono">https://{{ site.primaryDomain ?: 'example.com' }}</span>. Traefik then routes the domain here and issues the TLS certificate automatically.</li>
          <li>Select <strong>Direct from this server</strong> above and Save. Done — every publish is live immediately, no repo needed. Redirects, the 404 page and 404 tracking are all served by the engine; www requests 301 to the apex.</li>
        </ol>
      </details>
    </div>
    {% endif %}

    <div class="card">
      <h2 style="margin-top:0">Languages</h2>
      <div style="display:flex;flex-wrap:wrap;gap:.5rem;align-items:center">
        <span class="badge ok" style="display:inline-flex;align-items:center;gap:.4rem">
          {% if locale_flag_url(site.primaryLocale) %}<img src="{{ locale_flag_url(site.primaryLocale) }}" width="20" height="15" alt="" style="border-radius:2px;object-fit:cover" onerror="this.style.display='none'">{% endif %}
          {{ locale_name(site.primaryLocale) }} <span class="mut" style="font-weight:400">primary</span>
        </span>
        {% for l in site.locales %}
          <span class="badge mut" style="display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap">
            {% if locale_flag_url(l) %}<img src="{{ locale_flag_url(l) }}" width="20" height="15" alt="" style="border-radius:2px;object-fit:cover" onerror="this.style.display='none'">{% endif %}
            {{ locale_name(l) }}
            <form method="post" action="/sites/{{ site.handle }}/settings/action" class="inline" onsubmit="return confirm('Remove {{ locale_name(l) }}? All its translations and the /{{ l }}/ pages are deleted, then the site republishes.')">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="remove-language">
              <input type="hidden" name="locale" value="{{ l }}">
              <button type="submit" title="Remove {{ locale_name(l) }}" style="display:inline-flex;background:none;border:0;color:var(--danger);cursor:pointer;padding:0;margin:0;font:inherit;line-height:1">✕</button>
            </form>
          </span>
        {% endfor %}
      </div>

      {% if not translator_configured %}
        <p class="flash err" style="font-size:.85rem">Auto-translation is <strong>disabled</strong>: no translator is configured for this site. Add an <strong>OpenRouter key</strong> on your <a href="/account">Account</a> and select it as this site's <em>AI key</em> above (or configure the built-in translator). Added locales stay untranslated until then.</p>
      {% elseif site.locales|length %}
        <p class="mut" style="font-size:.83rem;margin:.2rem 0 .6rem">Auto-translation is active. Translation runs on the queue and republishes automatically; status per locale:</p>
        <table>
          <tr><th>Locale</th><th>Translated</th><th>Stale</th><th>Missing</th><th>Failed</th></tr>
          {% for loc, st in translation_status %}
          <tr>
            <td><span class="badge mut">{{ loc }}</span></td>
            <td>{{ st.translated }}{% if st.manual %} <span class="mut">(+{{ st.manual }} manual)</span>{% endif %} / {{ st.total }}</td>
            <td>{% if st.stale %}<span class="badge warn">{{ st.stale }}</span>{% else %}0{% endif %}</td>
            <td>{% if st.missing %}<span class="badge warn">{{ st.missing }}</span>{% else %}0{% endif %}</td>
            <td>{% if st.failed %}<span class="badge err">{{ st.failed }}</span>{% else %}0{% endif %}</td>
          </tr>
          {% if st.error %}
          <tr><td></td><td colspan="4" class="mut" style="font-size:.78rem;color:var(--danger)">last error: {{ st.error }}</td></tr>
          {% endif %}
          {% endfor %}
        </table>
        <p class="mut" style="font-size:.8rem;margin:.5rem 0 0">Missing/stale clear on the next translate+publish cycle. Failed = the provider rejected that item (check the AI key/quota).</p>
        {% if translation_failed %}
        <form method="post" action="/sites/{{ site.handle }}/settings/action" class="inline" style="margin-top:.6rem"
              data-busy="Re-running translation for the failed items… this can take a while.">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="retry-translations">
          <button class="button small" type="submit">&#8635; Retry {{ translation_failed }} failed translation{{ translation_failed > 1 ? 's' }}</button>
        </form>
        <span class="mut" style="font-size:.8rem;margin-left:.5rem">Re-attempts every failed (and stale/missing) item, then republishes.</span>
        {% endif %}
      {% endif %}

      <form method="post" action="/sites/{{ site.handle }}/settings/action" class="row" style="margin-top:1rem" onsubmit="if(!this.locale.value){alert('Choose a language first.');return false}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="add-language">
        <div style="min-width:15rem"><label>Add language</label>
          <div class="mediadrop" data-mediadrop>
            <input type="hidden" name="locale" value="">
            <button type="button" class="mediadrop-trigger"><span class="mediadrop-current"></span><span class="mediadrop-caret">▾</span></button>
            <div class="mediadrop-panel" hidden>
              <button type="button" class="mediadrop-opt" data-value="" data-thumb=""><span class="opt">🌐</span>— choose a language —</button>
              {% for code in locale_add_codes %}
              <button type="button" class="mediadrop-opt" data-value="{{ code }}" data-thumb="{{ locale_flag_url(code) }}">
                {% if locale_flag_url(code) %}<img class="opt" src="{{ locale_flag_url(code) }}" alt="" loading="lazy" onerror="this.style.visibility='hidden'">{% else %}<span class="opt">🌐</span>{% endif %}{{ locale_name(code) }}
              </button>
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="tight" style="align-self:end"><button class="button" type="submit">Add + translate</button></div>
      </form>
      <script>
      (function(){
        document.querySelectorAll('[data-mediadrop]').forEach(function(root){
          if(root.dataset.mdInit) return; root.dataset.mdInit='1';
          var input = root.querySelector('input[type=hidden]');
          var trigger = root.querySelector('.mediadrop-trigger');
          var current = root.querySelector('.mediadrop-current');
          var panel = root.querySelector('.mediadrop-panel');
          var opts = Array.prototype.slice.call(root.querySelectorAll('.mediadrop-opt'));
          function paint(opt){
            current.innerHTML = '';
            var thumb = opt.getAttribute('data-thumb');
            if(thumb){ var im = document.createElement('img'); im.className='opt'; im.src=thumb; im.alt=''; im.onerror=function(){this.style.visibility='hidden'}; current.appendChild(im); }
            else { var sp = document.createElement('span'); sp.className='opt'; sp.textContent='🌐'; current.appendChild(sp); }
            current.appendChild(document.createTextNode(' ' + opt.textContent.trim()));
          }
          function selectByValue(v){ var m = opts.filter(function(o){return o.getAttribute('data-value')===String(v);}); paint(m[0] || opts[0]); }
          selectByValue(input.value);
          trigger.addEventListener('click', function(e){ e.preventDefault(); panel.hidden = !panel.hidden; });
          opts.forEach(function(o){ o.addEventListener('click', function(e){ e.preventDefault(); input.value = o.getAttribute('data-value'); paint(o); panel.hidden = true; }); });
          document.addEventListener('click', function(e){ if(!root.contains(e.target)) panel.hidden = true; });
        });
      })();
      </script>
    </div>

    {# Read-mostly panels collapse by default so the column is short on arrival;
       each still opens in place. Counts are in the summary so you can tell
       whether opening one is worth it without opening it. #}
    <div class="card">
      <details>
        <summary style="font-weight:600;font-size:1.05rem">Components <span class="mut" style="font-weight:400">({{ components|length }})</span></summary>
        <table style="margin-top:.8rem">
          <tr><th>Handle</th><th>Type</th><th>Status</th></tr>
          {% for c in components %}
          <tr><td class="mono">{{ c.handle }}</td><td>{{ c.type }}</td><td><span class="badge {{ c.status }}">{{ c.status }}</span></td></tr>
          {% else %}
          <tr><td colspan="3" class="mut">None — upload via the API or MCP (<span class="mono">upsert_component</span>).</td></tr>
          {% endfor %}
        </table>
      </details>
    </div>

    <div class="card">
      <details>
        <summary style="font-weight:600;font-size:1.05rem">Header / footer scripts <span class="mut" style="font-weight:400">({{ scripts|length }})</span></summary>
      <p class="mut" style="font-size:.85rem">Analytics, chat widgets, pixels. Paste a snippet (injected verbatim) or a script URL (loaded with the chosen strategy). <strong>Any enabled script opts this site out of the 100/100/100/100 PageSpeed guarantee</strong> — the build relaxes the CSP + audit accordingly.</p>
      <table>
        <tr><th>Label</th><th>Where</th><th>How</th><th>Prio</th><th>On</th><th></th></tr>
        {% for s in scripts %}
        <tr>
          <td>{{ s.label ?: '(no label)' }}</td>
          <td class="mut mono">{{ s.location }}</td>
          <td class="mut mono">{{ s.strategy }}</td>
          <td class="mut">{{ s.priority }}</td>
          <td>{% if s.enabled %}<span class="badge ok">on</span>{% else %}<span class="badge mut">off</span>{% endif %}</td>
          <td style="white-space:nowrap">
            <button type="button" class="button small ghost" data-script-edit
              data-id="{{ s.id }}" data-label="{{ s.label }}" data-location="{{ s.location }}"
              data-strategy="{{ s.strategy }}" data-priority="{{ s.priority }}"
              data-enabled="{{ s.enabled ? 1 : 0 }}" data-code="{{ s.code }}">Edit</button>
            <form method="post" action="/sites/{{ site.handle }}/settings/action" class="inline" onsubmit="return confirm('Delete this script?')">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="script-delete"><input type="hidden" name="id" value="{{ s.id }}">
              <button class="button small ghost" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="mut">No scripts — the site ships zero JS.</td></tr>
        {% endfor %}
      </table>
      <details style="margin-top:1rem" id="script-form-details">
        <summary style="cursor:pointer" id="script-form-summary">Add a script</summary>
        <form method="post" action="/sites/{{ site.handle }}/settings/action" style="margin-top:.6rem" id="script-form">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="script-save">
          <input type="hidden" name="id" value="">
          <div class="row">
            <div><label>Label</label><input type="text" name="label" placeholder="Google Analytics"></div>
            <div class="tight"><label>Location</label>
              <select name="location">
                <option value="head">head</option><option value="body_open">body open</option><option value="body_end">body end</option>
              </select>
            </div>
            <div class="tight"><label>Strategy</label>
              <select name="strategy"><option value="defer">defer</option><option value="async">async</option><option value="blocking">blocking</option></select>
            </div>
            <div class="tight"><label>Priority</label><input type="number" name="priority" value="100" size="4"></div>
          </div>
          <label>Code <span class="mut">(a &lt;script&gt;…&lt;/script&gt; snippet, or just a script URL)</span></label>
          <textarea name="code" class="code" style="min-height:8rem"></textarea>
          <p style="margin:.8rem 0 0">
            <label style="display:inline-flex;align-items:center;gap:.5rem"><input type="checkbox" name="enabled" value="1" checked> enabled</label>
            <button class="button" type="submit" style="margin-left:1rem">Save script</button>
          </p>
        </form>
      </details>
      <script>
      // Edit = pre-fill the save form with the row's values; the backend's
      // script-save updates in place when an id is present.
      document.querySelectorAll('[data-script-edit]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var f = document.getElementById('script-form');
          f.querySelector('[name=id]').value = btn.dataset.id;
          f.querySelector('[name=label]').value = btn.dataset.label;
          f.querySelector('[name=location]').value = btn.dataset.location;
          f.querySelector('[name=strategy]').value = btn.dataset.strategy;
          f.querySelector('[name=priority]').value = btn.dataset.priority;
          f.querySelector('[name=code]').value = btn.dataset.code;
          f.querySelector('[name=enabled]').checked = btn.dataset.enabled === '1';
          document.getElementById('script-form-details').open = true;
          document.getElementById('script-form-summary').textContent =
            'Edit script — ' + (btn.dataset.label || '(no label)');
          f.scrollIntoView({behavior: 'smooth', block: 'center'});
          f.querySelector('[name=code]').focus();
        });
      });
      </script>
      </details>
    </div>

    <div class="card">
      <details>
        <summary style="font-weight:600;font-size:1.05rem">Redirects <span class="mut" style="font-weight:400">({{ redirects|length }})</span></summary>
      <p class="mut" style="font-size:.85rem;margin-top:.8rem">301/302 rules emitted to <span class="mono">_redirects</span>. A rule that shadows a live page is skipped automatically.</p>
      <form method="post" action="/sites/{{ site.handle }}/settings/action" class="row">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="redirect-save">
        <div><label>From <span class="mut">(/old-path)</span></label><input type="text" name="from_path" placeholder="/old" required></div>
        <div><label>To</label><input type="text" name="to_path" placeholder="/new" required></div>
        <div class="tight"><label>Status</label><select name="status"><option>301</option><option>302</option><option>308</option></select></div>
        <div class="tight" style="align-self:end"><button class="button" type="submit">Add</button></div>
      </form>
      <table style="margin-top:1rem">
        <tr><th>From</th><th>To</th><th>Status</th><th></th></tr>
        {% for r in redirects %}
        <tr>
          <td class="mono">{{ r.from_path }}</td><td class="mono">{{ r.to_path }}</td><td class="mut">{{ r.status }}</td>
          <td>
            <form method="post" action="/sites/{{ site.handle }}/settings/action" class="inline">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="redirect-delete"><input type="hidden" name="id" value="{{ r.id }}">
              <button class="button small ghost" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="mut">No redirects.</td></tr>
        {% endfor %}
      </table>
      </details>
    </div>

    {% if missing %}
    <div class="card">
      <h2 style="margin-top:0">Suggested redirects <span class="mut">(from captured 404s)</span></h2>
      <table>
        <tr><th>Missing path</th><th>Hits</th><th>Send to</th><th></th></tr>
        {% for m in missing %}
        <tr>
          <td class="mono">{{ m.path }}</td>
          <td class="mut">{{ m.hits }}</td>
          <td colspan="2">
            <form method="post" action="/sites/{{ site.handle }}/settings/action" class="row" style="gap:.4rem">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="missing-resolve"><input type="hidden" name="id" value="{{ m.id }}">
              <div><input type="text" name="to_path" placeholder="/new-home" required></div>
              <div class="tight"><button class="button small" type="submit">Create 301</button></div>
              <div class="tight">
                <button class="button small ghost" type="submit" formaction="/sites/{{ site.handle }}/settings/action" name="action" value="missing-clear">Dismiss</button>
              </div>
            </form>
          </td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}

  </div>

  {# Column two is the shell: the file tree, the editor you opened from it, and
     the snapshots of that same tree. Keeping all four shell surfaces together
     stops column one from being the whole page. #}
  <div>
    <div class="card">
      <h2 style="margin-top:0">Shell files</h2>
      <ul class="filetree">
        {% for f in files %}
        <li><a href="?file={{ f.path|url_encode }}">{{ f.path }}</a> <span class="mut">{{ (f.size_bytes / 1024)|number_format(1) }} KB</span></li>
        {% endfor %}
      </ul>
    </div>

    {% if edit_file %}
    <dialog id="shell-editor" class="modal wide">
      <form method="post" action="/sites/{{ site.handle }}/settings/action" id="shell-editor-form">
        <div class="m-head" style="display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap">
          <h3 style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Editing <span class="mono">{{ edit_file }}</span></h3>
          <label style="display:flex;align-items:center;gap:.45rem;margin:0;font-size:.82rem">Syntax
            <select id="shell-editor-mode" style="width:auto;padding:.3rem .5rem;font-size:.85rem"></select>
          </label>
        </div>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="shell-save">
        <input type="hidden" name="path" value="{{ edit_file }}">
        <div class="m-body">
          <textarea name="content" id="shell-editor-src" class="code" spellcheck="false">
{{ edit_content }}</textarea>
        </div>
        <div class="m-actions">
          <a class="button ghost" href="/sites/{{ site.handle }}/settings">Close</a>
          <button class="button" type="submit">Save (validates + rebuilds)</button>
        </div>
      </form>
    </dialog>
    <link rel="stylesheet" href="/assets/codemirror/lib/codemirror.css">
    <style>
      /* CodeMirror on the engine tokens, scoped to the editor modal. */
      #shell-editor .CodeMirror{height:66vh;background:var(--bg-2);color:var(--text);border:1px solid var(--border);border-radius:8px;font-family:var(--mono);font-size:.85rem;line-height:1.55}
      #shell-editor .CodeMirror-gutters{background:var(--bg-2);border-right:1px solid var(--border)}
      #shell-editor .CodeMirror-linenumber{color:var(--muted)}
      #shell-editor .CodeMirror-cursor{border-left:2px solid var(--accent)}
      #shell-editor .CodeMirror-selected,#shell-editor .CodeMirror-focused .CodeMirror-selected{background:rgba(42,134,255,.25)}
      #shell-editor .CodeMirror-activeline-background{background:rgba(255,255,255,.045)}
      #shell-editor .CodeMirror-matchingbracket{color:var(--ok) !important;outline:1px solid rgba(6,214,160,.45)}
      #shell-editor .cm-comment{color:var(--muted);font-style:italic}
      #shell-editor .cm-tag{color:#5ccfe6}
      #shell-editor .cm-bracket{color:#9bb0c6}
      #shell-editor .cm-attribute{color:#ffd580}
      #shell-editor .cm-string,#shell-editor .cm-string-2{color:#a8e07a}
      #shell-editor .cm-number,#shell-editor .cm-atom{color:#f78c6c}
      #shell-editor .cm-keyword{color:#c792ea}
      #shell-editor .cm-def{color:#82aaff}
      #shell-editor .cm-variable{color:var(--text)}
      #shell-editor .cm-variable-2{color:#82aaff}
      #shell-editor .cm-variable-3,#shell-editor .cm-type{color:#5ccfe6}
      #shell-editor .cm-property{color:#7ab3ff}
      #shell-editor .cm-operator{color:#89ddff}
      #shell-editor .cm-qualifier,#shell-editor .cm-builtin{color:#ffd580}
      #shell-editor .cm-meta{color:#9bb0c6}
      #shell-editor .cm-error{color:var(--danger)}
    </style>
    <script src="/assets/codemirror/lib/codemirror.js"></script>
    <script src="/assets/codemirror/mode/xml/xml.js"></script>
    <script src="/assets/codemirror/mode/css/css.js"></script>
    <script src="/assets/codemirror/mode/javascript/javascript.js"></script>
    <script src="/assets/codemirror/mode/htmlmixed/htmlmixed.js"></script>
    <script src="/assets/codemirror/addon/mode/multiplex.js"></script>
    <script src="/assets/codemirror/mode/twig/twig.js"></script>
    <script src="/assets/codemirror/addon/edit/matchbrackets.js"></script>
    <script src="/assets/codemirror/addon/edit/closebrackets.js"></script>
    <script src="/assets/codemirror/addon/selection/active-line.js"></script>
    <script>
    (function(){
      var dlg = document.getElementById('shell-editor');
      var form = document.getElementById('shell-editor-form');
      var path = {{ edit_file|json_encode|raw }};
      var closeUrl = '/sites/{{ site.handle }}/settings';

      // Open BEFORE initialising: CodeMirror measures itself, so it must be
      // created inside a visible dialog (a closed one is display:none).
      dlg.showModal();

      var MODES = [
        ['twig', 'Twig / HTML', {name: 'twig', base: 'text/html'}],
        ['html', 'HTML', 'htmlmixed'],
        ['css', 'CSS', 'css'],
        ['js', 'JavaScript', 'javascript'],
        ['json', 'JSON', {name: 'javascript', json: true}],
        ['xml', 'XML / SVG', 'xml'],
        ['plain', 'Plain text', null]
      ];
      function detect(p){
        p = p.toLowerCase();
        if (p.endsWith('.twig')) return 'twig';
        if (p.endsWith('.html') || p.endsWith('.htm')) return 'html';
        if (p.endsWith('.css')) return 'css';
        if (p.endsWith('.js') || p.endsWith('.mjs')) return 'js';
        if (p.endsWith('.json')) return 'json';
        if (p.endsWith('.svg') || p.endsWith('.xml')) return 'xml';
        return 'plain';
      }
      function modeFor(key){
        for (var i = 0; i < MODES.length; i++) if (MODES[i][0] === key) return MODES[i][2];
        return null;
      }
      var sel = document.getElementById('shell-editor-mode');
      MODES.forEach(function(m){
        var o = document.createElement('option');
        o.value = m[0]; o.textContent = m[1];
        sel.appendChild(o);
      });
      sel.value = detect(path);

      var cm = CodeMirror.fromTextArea(document.getElementById('shell-editor-src'), {
        mode: modeFor(sel.value),
        lineNumbers: true,
        indentUnit: 2, tabSize: 2, indentWithTabs: false,
        matchBrackets: true, autoCloseBrackets: true, styleActiveLine: true,
        extraKeys: {
          'Ctrl-S': function(){ form.requestSubmit(); },
          'Cmd-S': function(){ form.requestSubmit(); }
        }
      });
      sel.addEventListener('change', function(){ cm.setOption('mode', modeFor(sel.value)); });

      // Leaving the modal (Esc / backdrop / Close) returns to the clean settings
      // URL so ?file= never lingers on a page with no visible editor. Both
      // cancel (Esc) and close (backdrop via the layout's dialog wiring) lead
      // here; the flag keeps a save submit from being hijacked into a redirect.
      var submitting = false, left = false;
      function leave(){ if (!submitting && !left){ left = true; window.location = closeUrl; } }
      form.addEventListener('submit', function(){ submitting = true; cm.save(); });
      dlg.addEventListener('cancel', leave);
      dlg.addEventListener('close', leave);
    })();
    </script>
    {% endif %}

    <div class="card">
      <h2 style="margin-top:0">Shell snapshots</h2>
      <form method="post" action="/sites/{{ site.handle }}/settings/action" class="row">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="shell-snapshot">
        <div><label>Note</label><input type="text" name="note" placeholder="before redesign"></div>
        <div class="tight"><button class="button" type="submit">Snapshot now</button></div>
      </form>
      <table style="margin-top:1rem">
        <tr><th>Rev</th><th>Note</th><th>When</th><th></th></tr>
        {% for r in revisions %}
        <tr>
          <td>#{{ r.rev_no }}</td><td>{{ r.note }}</td><td class="mut">{{ r.created_at }}</td>
          <td>
            <div class="rowacts">
              <form method="post" action="/sites/{{ site.handle }}/settings/action" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="shell-restore">
                <input type="hidden" name="rev" value="{{ r.rev_no }}">
                <button class="button small ghost" type="submit">Restore</button>
              </form>
              <form method="post" action="/sites/{{ site.handle }}/settings/action" class="inline"
                    data-confirm="Delete snapshot #{{ r.rev_no }}? The archive is removed for good — this is the only copy, and it is not what Restore rolls back to afterwards."
                    data-confirm-title="Delete snapshot" data-confirm-ok="Delete" data-confirm-danger>
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="shell-delete">
                <input type="hidden" name="rev" value="{{ r.rev_no }}">
                <button class="button small danger" type="submit">Delete</button>
              </form>
            </div>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="mut">No snapshots yet.</td></tr>
        {% endfor %}
      </table>
    </div>
  </div>
</div>
{% endblock %}
