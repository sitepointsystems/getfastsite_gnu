{% extends 'dash-layout.html.twig' %}

{% block body %}
<style>
  /* Content action bar: equal-height, high-contrast buttons (#6). */
  .content-actions{display:flex;align-items:center;gap:.5rem;margin:0}
  .content-actions .button{min-height:36px;display:inline-flex;align-items:center;justify-content:center}
  /* Text search over the list. `stretch` (not a magic min-height) is what
     keeps the buttons exactly as tall as the input if either ever changes. */
  .content-search{display:flex;gap:.5rem;align-items:stretch;margin:0 0 1rem}
  .content-search input[type=search]{flex:1;min-width:0;margin:0}
  .content-search .button{white-space:nowrap;display:inline-flex;align-items:center}
  /* Row actions: real buttons for the two things you do constantly (edit,
     preview), everything rarer behind the kebab. */
  .rowacts .button.small{min-height:28px;display:inline-flex;align-items:center}
  .rowacts .button[disabled]{opacity:.45;cursor:not-allowed}
  .rowacts form{margin:0}
  /* Self-contained WYSIWYG (#14) — dashboard-only JS; published sites stay zero-JS.
     Progressive enhancement: the textarea is the canonical body_html field and
     works with JS disabled; the editor layers on top. */
  .wysiwyg{border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg-2)}
  .wy-toolbar{display:flex;flex-wrap:wrap;gap:.25rem;align-items:center;padding:.4rem .5rem;border-bottom:1px solid var(--border);background:var(--surface)}
  .wy-toolbar button{background:var(--bg-2);color:var(--text-2);border:1px solid var(--border);border-radius:6px;min-width:30px;height:28px;padding:0 .45rem;font-size:.8rem;cursor:pointer;line-height:1}
  .wy-toolbar button:hover{color:var(--text);border-color:var(--accent)}
  .wy-toolbar button.on{color:var(--text);border-color:var(--accent);background:rgba(42,134,255,.14)}
  .wy-toolbar .wy-sep{width:1px;height:20px;background:var(--border);margin:0 .2rem}
  .wy-toolbar select.wy-comp{width:auto;min-width:12rem;padding:.25rem .5rem;font-size:.8rem;height:28px;margin:0}
  /* The editable surface is an iframe so it loads the SITE's real CSS (isolated
     from the dashboard chrome) — the layout in the editor matches the published
     page. data-media-id images are shown via the thumbnail route. */
  .wy-frame{display:block;width:100%;min-height:26rem;max-height:44rem;border:0;background:#0a0f1a}
  .wysiwyg textarea.wy-source{border:0;border-radius:0;min-height:24rem}
  /* Source split view: designer left, CodeMirror right; both stay live. */
  .wysiwyg.split .wy-panes{display:grid;grid-template-columns:1fr 1fr}
  .wysiwyg.split .wy-frame{height:36rem;max-height:none}
  .wysiwyg .CodeMirror{display:none;background:var(--bg-2);color:var(--text);font-family:var(--mono);font-size:.83rem;line-height:1.5}
  .wysiwyg.split .CodeMirror{display:block;height:36rem;border-left:1px solid var(--border)}
  @media (max-width:1100px){
    .wysiwyg.split .wy-panes{grid-template-columns:1fr}
    .wysiwyg.split .wy-frame{height:22rem}
    .wysiwyg.split .CodeMirror{height:22rem;border-left:0;border-top:1px solid var(--border)}
  }
  /* CodeMirror on the engine tokens — keep in sync with settings.html.twig's
     #shell-editor block (same palette, different scope). */
  .wysiwyg .CodeMirror-gutters{background:var(--bg-2);border-right:1px solid var(--border)}
  .wysiwyg .CodeMirror-linenumber{color:var(--muted)}
  .wysiwyg .CodeMirror-cursor{border-left:2px solid var(--accent)}
  .wysiwyg .CodeMirror-selected,.wysiwyg .CodeMirror-focused .CodeMirror-selected{background:rgba(42,134,255,.25)}
  .wysiwyg .CodeMirror-activeline-background{background:rgba(255,255,255,.045)}
  .wysiwyg .CodeMirror-matchingbracket{color:var(--ok) !important;outline:1px solid rgba(6,214,160,.45)}
  .wysiwyg .cm-comment{color:var(--muted);font-style:italic}
  .wysiwyg .cm-tag{color:#5ccfe6}
  .wysiwyg .cm-bracket{color:#9bb0c6}
  .wysiwyg .cm-attribute{color:#ffd580}
  .wysiwyg .cm-string,.wysiwyg .cm-string-2{color:#a8e07a}
  .wysiwyg .cm-number,.wysiwyg .cm-atom{color:#f78c6c}
  .wysiwyg .cm-keyword{color:#c792ea}
  .wysiwyg .cm-variable{color:var(--text)}
  .wysiwyg .cm-error{color:var(--danger)}
</style>

<h1>{{ site.name }}</h1>
<p class="sub">Content — pure HTML bodies, images via <span class="mono">&lt;img data-media-id="N" alt="…"&gt;</span>.</p>
{% include 'site-nav.html.twig' %}

{# Every in-screen link keeps the current search, so filtering survives a tab
   switch, a page step and a round-trip through the editor. The separator is a
   bare `&` because this is a VARIABLE — autoescape turns it into `&amp;` on
   output, so writing `&amp;` here would ship a literal `&amp;amp;`. #}
{% set qs = search ? '&q=' ~ search|url_encode : '' %}

<div class="tabs">
  <a href="?type=post{{ trash ? '&amp;trash=1' }}{{ qs }}" class="{{ type == 'post' ? 'active' }}">Posts</a>
  <a href="?type=page{{ trash ? '&amp;trash=1' }}{{ qs }}" class="{{ type == 'page' ? 'active' }}">Pages</a>
  <span style="flex:1"></span>
  <div class="content-actions">
    {% if trash %}
      <a class="button small ghost" href="?type={{ type }}{{ qs }}">← Back to {{ type }}s</a>
    {% else %}
      <a class="button small" href="?type={{ type }}&amp;new=1">New {{ type }}</a>
      {# Build & publish used to sit here. It lives in the site nav now, on
         every screen rather than only this one, so a second copy on the one
         screen that already has it is just a thing to keep in sync. #}
      <a class="button small ghost" href="?type={{ type }}&amp;trash=1{{ qs }}">Trash</a>
    {% endif %}
  </div>
</div>

{# Text search. GET, so a result list is a shareable/bookmarkable URL and the
   browser's back button behaves. Omitting `page` resets paging on submit. #}
<form method="get" class="content-search">
  <input type="hidden" name="type" value="{{ type }}">
  {% if trash %}<input type="hidden" name="trash" value="1">{% endif %}
  <input type="search" name="q" value="{{ search }}" autocomplete="off"
         placeholder="Search {{ trash ? 'trashed ' }}{{ type }}s — title, slug, excerpt, SEO fields or body text"
         aria-label="Search {{ type }}s">
  <button class="button small" type="submit">Search</button>
  {% if search %}<a class="button small ghost" href="?type={{ type }}{{ trash ? '&amp;trash=1' }}">Clear</a>{% endif %}
</form>
{% if search %}
<p class="mut" style="font-size:.85rem;margin:0 0 .8rem">
  {{ trash ? items|length : total }} {{ (trash ? items|length : total) == 1 ? 'match' : 'matches' }} for “{{ search }}”{{ trash ? ' in trash' }}.
</p>
{% endif %}

{% if not trash and not creating and not editing and type == 'post' %}
{# Post categories. Server-rendered like the Components screen: ?category={slug}
   prefills the form, so it works with JS off. #}
<details class="card" {{ editing_category or categories|length == 0 ? 'open' }}>
  <summary style="font-weight:600;cursor:pointer">Categories — {{ categories|length }}</summary>
  <p class="mut" style="font-size:.85rem;margin:.6rem 0 .6rem">Each post has one. A category with at least one published post gets an archive at <span class="mono">{{ site.categoryPathPattern }}</span> ({{ site.archivePerPage }} per page, then <span class="mono">…/page/2/</span>), and its posts get the trail Home › Category › post.{% if '{category}' in site.postPathPattern %} Post URLs carry it (<span class="mono">{{ site.postPathPattern }}</span>), so a rename leaves 301s behind.{% endif %} Patterns are under Settings › SEO.</p>
  {% if categories|length %}
  <table>
    <tr><th>Name</th><th>Slug</th><th>Published posts</th><th></th></tr>
    {% for c in categories %}
    <tr>
      <td>{{ c.name }}</td>
      <td class="mono">{{ c.slug }}</td>
      <td class="mut">{{ category_counts[c.id]|default(0) }}</td>
      <td class="rowacts" style="display:flex;gap:.4rem">
        <a class="button small ghost" href="?type=post&amp;category={{ c.slug }}">Edit</a>
        <form method="post" action="/sites/{{ site.handle }}/content/action" data-confirm="Delete the category “{{ c.name }}”? This is refused while any post is still in it." data-confirm-title="Delete category" data-confirm-ok="Delete" data-confirm-danger>
          <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="category-delete"><input type="hidden" name="slug" value="{{ c.slug }}">
          <button class="button small ghost" type="submit">Delete</button>
        </form>
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
  <form method="post" action="/sites/{{ site.handle }}/content/action" id="category-form" style="margin-top:1rem">
    <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="category-save">
    <input type="hidden" name="original_slug" value="{{ editing_category ? editing_category.slug }}">
    <h3 style="margin:0 0 .4rem;font-size:1rem">{{ editing_category ? 'Edit “' ~ editing_category.name ~ '”' : 'New category' }}</h3>
    <div class="row">
      <div><label>Name</label><input type="text" name="name" value="{{ editing_category ? editing_category.name }}" required maxlength="200"></div>
      <div><label>Slug <span class="mut">(one URL segment; blank = from the name{{ editing_category ? '; changing it moves the archive' }})</span></label><input type="text" name="slug" value="{{ editing_category ? editing_category.slug }}"></div>
    </div>
    <label>Archive intro <span class="mut">(HTML, shown on page 1 of the archive)</span></label>
    <textarea name="description_html" class="code" rows="3">{{ editing_category ? editing_category.descriptionHtml }}</textarea>
    <div class="row">
      <div><label>SEO title</label><input type="text" name="seo_title" value="{{ editing_category ? editing_category.seoTitle }}"></div>
      <div><label>SEO description</label><input type="text" name="seo_description" value="{{ editing_category ? editing_category.seoDescription }}"></div>
    </div>
    <p style="margin:.9rem 0 0">
      <button class="button small" type="submit">{{ editing_category ? 'Save category' : 'Add category' }}</button>
      {% if editing_category %}<a class="button small ghost" href="?type=post">Cancel</a>{% endif %}
    </p>
  </form>
</details>
{% endif %}

{% if not trash and not creating and not editing and seo_issues|length %}
<details class="card" style="border-color:rgba(245,158,11,.4)">
  <summary style="font-weight:600;cursor:pointer">SEO lengths — {{ seo_issues|length }} issue(s) outside the Google limits</summary>
  <p class="mut" style="font-size:.85rem;margin:.6rem 0 .6rem">Google truncates titles around 60 characters and descriptions around 156; under ~30/120 wastes the snippet. Checked is what ships: the SEO title (falling back to the title) and SEO description (falling back to the excerpt).</p>
  {% if not seo_ai %}
  <p style="font-size:.85rem;margin:0 0 .6rem;color:#f59e0b">No AI is available for this site — fixes can only <strong>truncate over-long</strong> values; too-short titles/descriptions need an AI rewrite. Add an OpenRouter key on <a href="/account">Account → AI keys</a> and select it under <a href="/sites/{{ site.handle }}/settings">Site Settings → Site details</a>.</p>
  {% endif %}
  <table>
    <tr><th>Content</th><th>Problem</th><th>Length</th><th>Current text</th><th></th></tr>
    {% for i in seo_issues %}
    <tr>
      <td><a href="?type={{ i.type }}&amp;edit={{ i.id }}">{{ i.slug }}</a></td>
      <td><span class="badge warn">{{ i.kind }}</span></td>
      <td class="mut">{{ i.length }} / {{ i.limit }}</td>
      <td class="mut" style="max-width:26rem">{{ i.text|slice(0, 90) }}{{ i.text|length > 90 ? '…' }}</td>
      <td class="rowacts">
        <a class="button small ghost" href="?type={{ i.type }}&amp;edit={{ i.id }}">Edit</a>
        <button class="button small ghost" type="button" data-seo-fix="{{ i.id }}" data-seo-slug="{{ i.slug }}" title="{{ seo_ai ? 'Rewrite just this one with AI' : 'No AI key — over-long values are truncated, too-short ones are skipped' }}">{{ seo_ai ? 'Fix with AI' : 'Truncate' }}</button>
      </td>
    </tr>
    {% endfor %}
  </table>
  <p style="margin:.9rem 0 0">
    <button class="button small" type="button" data-seo-fix-all>{{ seo_ai ? 'Fix all with AI' : 'Truncate all over-long' }}</button>
    <span class="mut" style="font-size:.8rem;margin-left:.5rem">{{ seo_ai ? "Rewrites them to fit (uses the site's AI key or the engine's gateway; falls back to smart truncation for over-long ones), then republishes." : 'Without an AI key only over-long values can be truncated; too-short ones are skipped.' }}</span>
  </p>
</details>

{# SEO-fix progress dialog: the CLIENT drives the run — one POST per flagged
   row (op=row, a single AI call each), then op=publish once when anything
   changed. Each step is a short request, so a failing AI shows its error on
   the exact row it failed instead of a background job dying silently. #}
<dialog id="seo-fix-modal" class="modal">
  <div class="m-head"><h3 id="seo-fix-title">Fixing SEO lengths…</h3></div>
  <div class="m-body">
    <div style="height:.5rem;border:1px solid var(--border);border-radius:99px;overflow:hidden;background:var(--bg-2)">
      <div id="seo-fix-bar" style="height:100%;width:0%;background:var(--accent);transition:width .25s ease"></div>
    </div>
    <p class="mut" id="seo-fix-step" style="font-size:.85rem;margin:.6rem 0 0"></p>
    <div id="seo-fix-log" class="m-scroll" style="font-size:.83rem;margin-top:.6rem"></div>
  </div>
  <div class="m-actions"><button type="button" class="button small" id="seo-fix-close" data-modal-close disabled>Close</button></div>
</dialog>

<script>
(function () {
  var CSRF = {{ csrf|json_encode|raw }};
  var URL = {{ ('/sites/' ~ site.handle ~ '/content/seo-fix')|json_encode|raw }};
  // One entry per flagged CONTENT row — a row with a title AND a description
  // issue is still one fix call.
  var seen = {};
  var ROWS = [];
  {% for i in seo_issues %}
  if (!seen[{{ i.id }}]) { seen[{{ i.id }}] = 1; ROWS.push({ id: {{ i.id }}, slug: {{ i.slug|json_encode|raw }} }); }
  {% endfor %}

  var dlg = document.getElementById('seo-fix-modal');
  var bar = document.getElementById('seo-fix-bar');
  var step = document.getElementById('seo-fix-step');
  var log = document.getElementById('seo-fix-log');
  var closeBtn = document.getElementById('seo-fix-close');
  var running = false;
  // The run mutates content — no closing (Esc/backdrop) mid-flight; a step in
  // progress would finish server-side with the dialog gone.
  dlg.addEventListener('cancel', function (e) { if (running) e.preventDefault(); });
  dlg.addEventListener('click', function (e) { if (running) e.stopImmediatePropagation(); }, true);
  dlg.addEventListener('close', function () { window.location.reload(); });

  function line(text, cls) {
    var p = document.createElement('p');
    p.style.margin = '.25rem 0';
    p.style.borderTop = '1px solid var(--border)';
    p.style.paddingTop = '.25rem';
    if (cls === 'err') p.style.color = '#f87171';
    if (cls === 'mut') p.className = 'mut';
    p.textContent = text;
    log.appendChild(p);
    log.scrollTop = log.scrollHeight;
  }

  function post(fields) {
    var body = new URLSearchParams(fields);
    body.set('_csrf', CSRF);
    return fetch(URL, { method: 'POST', body: body, credentials: 'same-origin' }).then(function (res) {
      return res.json().catch(function () {
        throw new Error('HTTP ' + res.status + ' — unexpected response (are you still signed in?)');
      });
    }).then(function (json) {
      if (!json.success) throw new Error((json.error && json.error.message) || 'Unknown error');
      return json.data;
    });
  }

  async function run(rows) {
    running = true;
    closeBtn.disabled = true;
    bar.style.width = '0%';
    log.textContent = '';
    document.getElementById('seo-fix-title').textContent =
      rows.length === 1 ? 'Fixing "' + rows[0].slug + '"…' : 'Fixing ' + rows.length + ' items…';
    dlg.showModal();

    var fixed = 0, failed = 0, skipped = 0;
    // Typical raw SSE weight of one title+description answer — the scale
    // that maps streamed bytes onto this row's slice of the bar. The cap
    // keeps a chatty model from overshooting before the request returns.
    var EXPECTED_BYTES = 6000;
    for (let i = 0; i < rows.length; i++) {
      let label = 'Rewriting ' + (i + 1) + ' of ' + rows.length + ': ' + rows[i].slug;
      step.textContent = label + '…';
      // Real progress WITHIN the row: while the AI answer streams from the
      // gateway, the server drops its cumulative byte count into Redis and
      // this poll moves the bar with the generation. (On a single-worker
      // dev server the poll queues behind the row request — the bar then
      // just falls back to per-row steps.)
      let polling = true;
      let poll = setInterval(function () {
        post({ op: 'progress', id: rows[i].id }).then(function (d) {
          if (!polling || !d.bytes) return; // a late response must not drag the bar back
          var frac = Math.min(0.95, d.bytes / EXPECTED_BYTES);
          bar.style.width = (((i + frac) / rows.length) * 100).toFixed(1) + '%';
          step.textContent = label + ' — ' + (d.bytes / 1024).toFixed(1) + ' KB streamed…';
        }).catch(function () {});
      }, 400);
      try {
        var data = await post({ op: 'row', id: rows[i].id });
        fixed += data.fixed; failed += data.failed; skipped += data.skipped;
        (data.items || []).forEach(function (it) {
          line(rows[i].slug + ' — ' + it.result, it.result.indexOf('failed') === 0 ? 'err' : (it.result.indexOf('fixed') === 0 ? '' : 'mut'));
        });
        if (!(data.items || []).length) line(rows[i].slug + ' — already within the limits', 'mut');
      } catch (e) {
        failed++;
        line(rows[i].slug + ' — ' + e.message, 'err');
      } finally {
        polling = false;
        clearInterval(poll);
      }
      bar.style.width = Math.round(((i + 1) / rows.length) * 100) + '%';
    }

    var summary = fixed + ' fixed, ' + skipped + ' skipped, ' + failed + ' failed.';
    if (fixed > 0) {
      step.textContent = 'Republishing the site…';
      try {
        await post({ op: 'publish' });
        summary += ' Rebuild + publish queued.';
      } catch (e) {
        line('Republish failed: ' + e.message, 'err');
      }
    }
    bar.style.width = '100%';
    step.textContent = 'Done — ' + summary;
    running = false;
    closeBtn.disabled = false;
  }

  document.querySelectorAll('[data-seo-fix]').forEach(function (b) {
    b.addEventListener('click', function () {
      run([{ id: parseInt(b.getAttribute('data-seo-fix'), 10), slug: b.getAttribute('data-seo-slug') }]);
    });
  });
  var all = document.querySelector('[data-seo-fix-all]');
  if (all) all.addEventListener('click', function () { run(ROWS); });
})();
</script>
{% endif %}

{% if creating or editing %}
<div class="card">
  <h2 style="margin-top:0">{{ editing ? 'Edit: ' ~ editing.title : 'New ' ~ type }}</h2>
  <form method="post" action="/sites/{{ site.handle }}/content/action">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="type" value="{{ editing ? editing.type : type }}">
    {% if editing %}<input type="hidden" name="id" value="{{ editing.id }}">{% endif %}
    <div class="row">
      <div><label>Title</label><input type="text" name="title" value="{{ editing ? editing.title }}" required></div>
      <div><label>Slug <span class="mut">(blank = from title)</span></label><input type="text" name="slug" value="{{ editing ? editing.slug }}"></div>
    </div>
    <label>Excerpt</label>
    <input type="text" name="excerpt" value="{{ editing ? editing.excerpt }}">
    <label>TL;DR <span class="mut">(HTML fragment — the shell renders it as a styled summary box; leave blank for none)</span></label>
    <textarea name="tldr" class="code" rows="3">{{ editing ? editing.tldr }}</textarea>
    <label>Intro <span class="mut">(HTML fragment — rendered as the styled lead above the body)</span></label>
    <textarea name="intro" class="code" rows="3">{{ editing ? editing.intro }}</textarea>
    <label>Body HTML</label>
    <div class="wysiwyg" data-wysiwyg data-site="{{ site.handle }}">
      <div class="wy-toolbar" hidden>
        <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
        <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
        <button type="button" data-cmd="strikeThrough" title="Strikethrough"><s>S</s></button>
        <span class="wy-sep"></span>
        <button type="button" data-block="h2" title="Heading 2">H2</button>
        <button type="button" data-block="h3" title="Heading 3">H3</button>
        <button type="button" data-block="p" title="Paragraph">P</button>
        <button type="button" data-block="blockquote" title="Quote">&#10077;</button>
        <button type="button" data-block="pre" title="Code block">&lt;/&gt;</button>
        <span class="wy-sep"></span>
        <button type="button" data-cmd="insertUnorderedList" title="Bullet list">&bull; List</button>
        <button type="button" data-cmd="insertOrderedList" title="Numbered list">1. List</button>
        <span class="wy-sep"></span>
        <button type="button" data-link title="Insert link">&#128279;</button>
        <button type="button" data-cmd="unlink" title="Remove link">unlink</button>
        <button type="button" data-img title="Insert image by media id">&#128247; img</button>
        <button type="button" data-cmd="removeFormat" title="Clear formatting">clear</button>
        {% if components|length %}
        <span class="wy-sep"></span>
        <select class="wy-comp" title="Insert a component placeholder">
          <option value="">Insert component…</option>
          {% for c in components %}<option value="{{ c.handle }}">{{ c.handle }}</option>{% endfor %}
        </select>
        {% endif %}
        <span style="flex:1"></span>
        <button type="button" data-source title="Edit the raw HTML">Source</button>
      </div>
      <div class="wy-panes">
        <iframe class="wy-frame" title="Body editor" hidden></iframe>
        <textarea name="body_html" class="code wy-source">{{ editing ? editing.bodyHtml }}</textarea>
      </div>
    </div>
    <div class="row">
      <div>
        <label>Status</label>
        <select name="status">
          {% for s in ['draft', 'published', 'scheduled', 'archived'] %}
            <option value="{{ s }}" {{ editing and editing.status == s ? 'selected' }}>{{ s }}</option>
          {% endfor %}
        </select>
      </div>
      <div><label>Publish date/time <span class="mut">(UTC — the date shown on the post; with status “scheduled” it also auto-publishes then)</span></label><input type="datetime-local" name="scheduled_at" value="{{ editing ? (editing.scheduledAt ?: editing.publishedAt)|slice(0, 16) }}"></div>
      <div><label>Author</label><input type="text" name="author_name" value="{{ editing ? editing.authorName }}"></div>
      {% if (editing ? editing.type : type) == 'post' %}
      <div>
        <label>Category <span class="mut">(the archive it is listed in{{ '{category}' in site.postPathPattern ? ', and part of its URL' }})</span></label>
        <select name="category">
          <option value="">— none —</option>
          {% for c in categories %}<option value="{{ c.id }}" {{ editing and editing.categoryId == c.id ? 'selected' }}>{{ c.name }} ({{ c.slug }})</option>{% endfor %}
        </select>
      </div>
      {% endif %}
    </div>
    <label>Conclusion <span class="mut">(HTML fragment — rendered as a closing section after the body)</span></label>
    <textarea name="conclusion" class="code" rows="3">{{ editing ? editing.conclusion }}</textarea>
    <div class="row">
      <div><label>SEO title</label><input type="text" name="seo_title" value="{{ editing ? editing.seoTitle }}"></div>
      <div><label>SEO description</label><input type="text" name="seo_description" value="{{ editing ? editing.seoDescription }}"></div>
    </div>
    <div class="row" style="margin-top:.6rem">
      <div class="tight"><label style="display:flex;align-items:center;gap:.4rem;margin:0"><input type="checkbox" name="noindex" value="1" {{ editing and editing.noindex ? 'checked' }}> Hide from search engines <span class="mut">(noindex — also left out of sitemap.xml and llms.txt)</span></label></div>
      <div class="tight"><label style="display:flex;align-items:center;gap:.4rem;margin:0"><input type="checkbox" name="nofollow" value="1" {{ editing and editing.nofollow ? 'checked' }}> Don't follow links <span class="mut">(nofollow)</span></label></div>
    </div>
    <details style="margin-top:.9rem">
      <summary class="mut" style="cursor:pointer;font-size:.88rem">Extra structured data <span class="mut">(optional — a Product, Event, HowTo or Recipe for this page)</span></summary>
      <p class="mut" style="font-size:.83rem;margin:.6rem 0 .35rem">This page already ships a schema.org graph describing the site, the page, its breadcrumb and (on posts) the article. Anything you put here is <strong>merged into</strong> that graph, so don't repeat those types. Paste a bare node, an array of nodes, or a <span class="mono">{"@graph":[…]}</span> document — <span class="mono">@context</span> is optional. A node declaring its own Article type replaces the generated one.</p>
      <textarea name="json_ld" class="code" rows="6" spellcheck="false" placeholder='{"@type":"Product","name":"Widget","offers":{"@type":"Offer","price":"49.00","priceCurrency":"EUR"}}'>{{ editing ? editing.jsonLd }}</textarea>
    </details>
    <p style="margin:1.25rem 0 0">
      <button class="button" type="submit">Save</button>
      <a class="button ghost" href="/sites/{{ site.handle }}/content?type={{ type }}">Cancel</a>
    </p>
  </form>

  {% if editing and site.factCheckEnabled %}
  <div style="border-top:1px solid var(--border);margin-top:1.25rem;padding-top:1rem">
    {% if fact_check_configured %}
    <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
      <form method="post" action="/sites/{{ site.handle }}/content/action" class="inline" data-busy="Fact-checking with {{ fact_check_model }}… this can take up to a minute.">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="fact-check">
        <input type="hidden" name="id" value="{{ editing.id }}">
        <input type="hidden" name="type" value="{{ editing.type }}">
        <button class="button ghost" type="submit">&#128269; Fact-check</button>
      </form>
      <form method="post" action="/sites/{{ site.handle }}/content/action" class="inline"
            data-confirm="Fact-check and automatically rewrite the body to correct contradicted and unverified claims? Review the changes before publishing." data-confirm-title="Fact-check &amp; auto-correct" data-confirm-ok="Check &amp; correct"
            data-busy="Fact-checking &amp; correcting with {{ fact_check_model }}… this can take up to a minute.">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="action" value="fact-check-correct">
        <input type="hidden" name="id" value="{{ editing.id }}">
        <input type="hidden" name="type" value="{{ editing.type }}">
        <button class="button" type="submit">&#10003; Fact-check &amp; auto-correct</button>
      </form>
      {% if fact_check_report %}<button type="button" class="button ghost small" data-modal-open="#fc-modal">View last report</button>{% endif %}
    </div>
    <p class="mut" style="font-size:.83rem;margin:.5rem 0 0">Verifies prices, stats and product/expert claims against live web sources — using <span class="mono">{{ fact_check_model }}</span>.</p>
    {% else %}
    <p class="mut" style="font-size:.88rem;margin:0">&#128269; Fact-checking needs an AI key. Add an <strong>OpenRouter</strong> key on your <a href="/account">Account</a>, then select it on this site's <a href="/sites/{{ site.handle }}/settings">Settings</a>.</p>
    {% endif %}

    {% if fact_check_report %}
    <dialog id="fc-modal" class="modal"{% if fact_check_show %} data-modal-auto{% endif %}>
      <div class="m-head"><h3>Fact-check report</h3><p class="mut" style="margin:0;font-size:.8rem">{% if fact_check_report.model %}<span class="mono">{{ fact_check_report.model }}</span>{% if fact_check_report.checked_at %} · {% endif %}{% endif %}{{ fact_check_report.checked_at }}</p></div>
      <div class="m-body m-scroll">
        {% if fact_check_report.summary %}<p style="margin:0 0 .6rem">{{ fact_check_report.summary }}</p>{% endif %}
        {% for cl in fact_check_report.claims %}
        <div style="border-top:1px solid var(--border);padding:.6rem 0">
          <span class="badge {{ cl.verdict == 'supported' ? 'ok' : (cl.verdict == 'contradicted' ? 'err' : 'warn') }}">{{ cl.verdict }}</span>
          <span>{{ cl.claim }}</span>
          {% if cl.note %}<div class="mut" style="font-size:.85rem;margin-top:.25rem">{{ cl.note }}</div>{% endif %}
          {% if cl.sources|length %}<div style="font-size:.8rem;margin-top:.2rem">{% for s in cl.sources %}<a href="{{ s }}" target="_blank" rel="noopener">source</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
        </div>
        {% else %}
        <p class="mut" style="font-size:.9rem;margin:.4rem 0 0">No checkable claims found.</p>
        {% endfor %}
      </div>
      <div class="m-actions"><button type="button" class="button small" data-modal-close>Close</button></div>
    </dialog>
    {% endif %}
  </div>
  {% elseif editing %}
  <div style="border-top:1px solid var(--border);margin-top:1.25rem;padding-top:1rem">
    <p class="mut" style="font-size:.88rem;margin:0">&#128269; Want to verify claims against live web sources? Enable <strong>fact-checking</strong> for this site on its <a href="/sites/{{ site.handle }}/settings">Settings</a>.</p>
  </div>
  {% endif %}
</div>
{% endif %}

{% if trash %}<p class="sub">Trash — deleted {{ type }}s. Restore brings one back; purge deletes it permanently.</p>{% endif %}

{% set show_translations = site.locales|length and not trash %}
{% set columns = 5 + (show_translations ? 1 : 0) + (trash ? 0 : 1) %}
<table>
  <tr>
    <th>Title</th><th>Status</th><th>Slug</th>
    {% if show_translations %}<th>Translations</th>{% endif %}
    {% if not trash %}<th>Indexable</th>{% endif %}
    <th>{{ trash ? 'Deleted' : 'Date' }}</th><th></th>
  </tr>
  {% for c in items %}
  <tr>
    <td>{{ c.title }}{% if c.warnings|length %} <span class="badge warn" title="{{ c.warnings|join(' ') }}">warn</span>{% endif %}</td>
    <td><span class="badge {{ c.status }}">{{ c.status }}</span></td>
    <td class="mono">{{ c.slug }}</td>
    {% if show_translations %}
    <td>
      {% for locale in site.locales %}
        {% set st = translations[c.id][locale]|default('missing') %}
        <span class="badge {{ st == 'translated' or st == 'manual' ? 'ok' : (st == 'stale' or st == 'pending' ? 'warn' : 'err') }}" title="{{ locale_name(locale) }}: {{ st }}" style="display:inline-flex;align-items:center;gap:.25rem">{% if locale_flag_url(locale) %}<img src="{{ locale_flag_url(locale) }}" width="18" height="13" alt="" style="border-radius:2px;object-fit:cover;vertical-align:middle" onerror="this.replaceWith(document.createTextNode('{{ locale }}'))">{% else %}{{ locale_flag(locale) }}{% endif %}</span>
      {% endfor %}
    </td>
    {% endif %}
    {% if not trash %}
    <td>
      {% if c.noindex %}
        <span class="badge err" title="noindex — this page ships a robots meta tag and is left out of sitemap.xml and llms.txt">noindex</span>
      {% elseif c.status == 'published' %}
        <span class="badge ok" title="Indexable — in sitemap.xml and llms.txt">yes</span>
      {% else %}
        <span class="badge mut" title="{{ c.status }} — not built, so it isn't on the live site at all">—</span>
      {% endif %}
    </td>
    {% endif %}
    <td class="mut">{{ trash ? c.deletedAt : (c.publishedAt ?: c.scheduledAt ?: c.createdAt) }}</td>
    <td>
      <div class="rowacts">
      {% if trash %}
        <form method="post" action="/sites/{{ site.handle }}/content/action" class="inline">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="restore">
          <input type="hidden" name="id" value="{{ c.id }}">
          <button class="button small ghost" type="submit">Restore</button>
        </form>
        <div class="kebab">
          <button type="button" class="kebab-trigger" data-kebab aria-haspopup="true" aria-label="More actions for {{ c.title }}">&#8942;</button>
          <div class="kebab-menu">
            <div class="danger-zone">
              <span class="zone-label">Danger zone</span>
              <form method="post" action="/sites/{{ site.handle }}/content/action" data-confirm="Permanently delete “{{ c.title }}”? This cannot be undone." data-confirm-title="Delete permanently" data-confirm-ok="Delete" data-confirm-danger>
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="purge">
                <input type="hidden" name="id" value="{{ c.id }}">
                <input type="hidden" name="type" value="{{ c.type }}">
                <button type="submit">Delete permanently</button>
              </form>
            </div>
          </div>
        </div>
      {% else %}
        <a class="button small ghost" href="?type={{ type }}&amp;edit={{ c.id }}{{ qs }}">Edit</a>
        {# Preview deep-links into the site's own preview tree, which is built
           from PUBLISHED content only — a draft has no page there to open. #}
        {% if c.status == 'published' %}
          {% set preview_path = (c.type == 'post' ? site.postPathPattern : site.pagePathPattern)|replace({'{slug}': c.slug})|trim('/') %}
          <a class="button small ghost" href="/sites/{{ site.handle }}/preview/{{ preview_path }}/" target="_blank" rel="noopener"
             title="Open this page in the site preview (rebuilds first if anything changed)">Preview</a>
        {% else %}
          <button class="button small ghost" type="button" disabled
                  title="Only published content is built — set the status to published to preview this page.">Preview</button>
        {% endif %}
        <div class="kebab">
          <button type="button" class="kebab-trigger" data-kebab aria-haspopup="true" aria-label="More actions for {{ c.title }}">&#8942;</button>
          <div class="kebab-menu">
            {% if site.locales|length %}
            <form method="post" action="/sites/{{ site.handle }}/content/action"
                  data-confirm="Re-translate “{{ c.title }}” into all {{ site.locales|length }} language{{ site.locales|length > 1 ? 's' }}? The current versions are discarded and regenerated from this page's source — use this when a translation is wrong even though it looks up to date."
                  data-confirm-title="Re-translate this page" data-confirm-ok="Re-translate">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="retranslate">
              <input type="hidden" name="id" value="{{ c.id }}">
              <input type="hidden" name="type" value="{{ c.type }}">
              <button type="submit" title="Force this page to translate again in every language">Re-translate</button>
            </form>
            {% endif %}
            <div class="danger-zone">
              <span class="zone-label">Danger zone</span>
              <form method="post" action="/sites/{{ site.handle }}/content/action" data-confirm="Move “{{ c.title }}” to trash?" data-confirm-title="Move to trash" data-confirm-ok="Move to trash">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" value="{{ c.id }}">
                <button type="submit">Move to trash</button>
              </form>
            </div>
          </div>
        </div>
      {% endif %}
      </div>
    </td>
  </tr>
  {% else %}
  <tr><td colspan="{{ columns }}" class="mut">
    {%- if search -%}
      No {{ trash ? 'trashed ' }}{{ type }}s match “{{ search }}”.
    {%- else -%}
      {{ trash ? 'Trash is empty.' : 'No ' ~ type ~ 's yet.' }}
    {%- endif -%}
  </td></tr>
  {% endfor %}
</table>

{% if pages > 1 and not trash %}
<p style="margin-top:1rem">
  {% for p in 1..pages %}
    {% if p == page %}<strong>{{ p }}</strong>{% else %}<a href="?type={{ type }}&amp;page={{ p }}{{ qs }}">{{ p }}</a>{% endif %}
  {% endfor %}
</p>
{% endif %}

{# Link modal for the WYSIWYG toolbar — replaces the native prompt(). Prefills
   the href when the caret/selection sits inside an existing link, so links can
   be edited in place; Remove unwraps it. Backdrop/Cancel wiring comes from the
   layout's shared dialog.modal script. #}
<dialog id="wy-link" class="modal">
  <div class="m-head"><h3 id="wy-link-title">Insert link</h3></div>
  <div class="m-body">
    <label>URL</label>
    <input type="text" id="wy-link-url" placeholder="https://example.com — or /page/, mailto:, #anchor" autocomplete="off" spellcheck="false">
    <p class="mut" id="wy-link-hint" style="font-size:.83rem;margin:.5rem 0 0"></p>
  </div>
  <div class="m-actions">
    <button type="button" class="button danger small" id="wy-link-remove" hidden>Remove link</button>
    <span style="flex:1"></span>
    <button type="button" class="button ghost small" data-modal-close>Cancel</button>
    <button type="button" class="button small" id="wy-link-apply">Apply</button>
  </div>
</dialog>

{% if creating or editing %}
{# CodeMirror (same local bundle as the Site-Settings shell editor) powers the
   Source split view. Loaded only when the editor form is on the page. #}
<link rel="stylesheet" href="/assets/codemirror/lib/codemirror.css">
<script src="/assets/codemirror/lib/codemirror.js"></script>
<script src="/assets/codemirror/mode/xml/xml.js"></script>
<script src="/assets/codemirror/mode/css/css.js"></script>
<script src="/assets/codemirror/mode/javascript/javascript.js"></script>
<script src="/assets/codemirror/mode/htmlmixed/htmlmixed.js"></script>
<script src="/assets/codemirror/addon/edit/matchbrackets.js"></script>
<script src="/assets/codemirror/addon/edit/closebrackets.js"></script>
<script src="/assets/codemirror/addon/selection/active-line.js"></script>
{% endif %}

{# WYSIWYG (#14, #26). Dashboard-only. The editable surface is an iframe that
   loads the SITE's real CSS so the layout is predictable and data-media-id
   images render (via the thumbnail route). The plain textarea stays the
   canonical body_html field: if init fails it remains visible (no regression),
   and the Source toggle is always an escape hatch to raw HTML. #}
<script>
(function(){
  var root = document.querySelector('[data-wysiwyg]');
  if(!root) return;
  var frame = root.querySelector('.wy-frame');
  var ta = root.querySelector('.wy-source');
  var toolbar = root.querySelector('.wy-toolbar');
  if(!frame || !ta || !toolbar) return;

  var handle = root.getAttribute('data-site') || '';
  var thumbBase = '/sites/' + handle + '/media/';
  var doc, edit, sourceMode = false;
  var cm = null, split = false, lastEdited = 'editor', muteCm = false;
  var cmPushTimer = null, edPushTimer = null, mapTimer = null;

  function editorDoc(){
    return '<!doctype html><html><head><meta charset="utf-8"><base target="_blank">'
      + '<link rel="stylesheet" href="/sites/' + encodeURIComponent(handle) + '/shell.css">'
      + '<style>html,body{margin:0}body{padding:1rem;box-sizing:border-box;min-height:22rem}'
      + '.wy-body{outline:none;min-height:20rem}'
      + '[data-fs-component],[data-fs-embed]{display:block;margin:.5rem 0;padding:.5rem .7rem;'
      + 'border:1px dashed #2a86ff;border-radius:6px;color:#2a86ff;font:600 12px/1.4 ui-monospace,monospace}'
      + '[data-fs-component]::before{content:"\\2699 component: " attr(data-fs-component)}'
      + '[data-fs-component] *{display:none}'
      + 'img{max-width:100%}img[data-media-id]:not([src]){min-width:60px;min-height:40px;outline:2px dashed #888}'
      + '</style></head><body><div class="article-body wy-body" contenteditable="true"></div></body></html>';
  }

  function resolveImages(){
    var imgs = edit.querySelectorAll('img[data-media-id]');
    for(var i=0;i<imgs.length;i++){
      var id = imgs[i].getAttribute('data-media-id');
      if(id && !imgs[i].getAttribute('src')) imgs[i].setAttribute('src', thumbBase + encodeURIComponent(id) + '/thumb');
    }
  }
  // Canonical HTML for saving: strip the display-only src from media images.
  function cleanHtml(){
    var clone = edit.cloneNode(true);
    var imgs = clone.querySelectorAll('img[data-media-id]');
    for(var i=0;i<imgs.length;i++){ imgs[i].removeAttribute('src'); imgs[i].removeAttribute('loading'); }
    return clone.innerHTML;
  }
  function sync(){
    if(sourceMode) return;
    ta.value = cleanHtml();
    if(split && cm !== null){
      clearTimeout(cmPushTimer);
      cmPushTimer = setTimeout(function(){
        if(!split || cm.hasFocus()) return;
        var v = cleanHtml();
        if(cm.getValue() === v) return;
        var si = cm.getScrollInfo();
        muteCm = true; cm.setValue(v); muteCm = false;
        cm.scrollTo(si.left, si.top);
      }, 400);
    }
  }
  function escHtml(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  try {
    frame.hidden = false; toolbar.hidden = false; ta.style.display = 'none';
    doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
    if(!doc || typeof doc.execCommand !== 'function') throw new Error('no iframe doc');
    doc.open(); doc.write(editorDoc()); doc.close();
    edit = doc.querySelector('.wy-body');
    edit.innerHTML = ta.value;
    resolveImages();
  } catch(e){
    frame.hidden = true; toolbar.hidden = true; ta.style.display = ''; // graceful fallback
    return;
  }

  edit.addEventListener('input', function(){ lastEdited = 'editor'; resolveImages(); sync(); });

  // Pasting a bare URL inserts a real <a href> link (so a pasted YouTube URL
  // becomes a player at build). With text selected, the selection becomes the
  // link instead. Anything that isn't a lone URL pastes normally.
  edit.addEventListener('paste', function(ev){
    var dt = ev.clipboardData;
    if(!dt) return;
    var text = (dt.getData('text/plain') || '').trim();
    if(!/^https?:\/\/\S+$/i.test(text)) return;
    ev.preventDefault();
    var sel = doc.getSelection();
    if(sel && sel.rangeCount && !sel.isCollapsed){ exec('createLink', text); return; }
    var esc = escHtml(text);
    try { doc.execCommand('insertHTML', false, '<a href="' + esc + '">' + esc + '</a>'); } catch(e){}
    resolveImages(); sync();
  });

  // Link modal (replaces the native prompt). With the caret or selection in
  // an existing link it opens prefilled for in-place editing; with plain text
  // selected, Apply wraps the selection; with nothing selected it inserts the
  // URL as its own link text.
  var linkDlg = document.getElementById('wy-link');
  var linkUrl = document.getElementById('wy-link-url');
  var linkTitle = document.getElementById('wy-link-title');
  var linkHint = document.getElementById('wy-link-hint');
  var linkRemove = document.getElementById('wy-link-remove');
  var linkApply = document.getElementById('wy-link-apply');
  var savedRange = null, editingA = null;

  function anchorFrom(node){
    while(node && node !== edit){
      if(node.nodeType === 1 && node.tagName === 'A') return node;
      node = node.parentNode;
    }
    return null;
  }
  function openLinkModal(){
    if(!linkDlg || typeof linkDlg.showModal !== 'function'){
      var u = prompt('Link URL:', 'https://'); if(u) exec('createLink', u); return;
    }
    var sel = doc.getSelection();
    savedRange = (sel && sel.rangeCount) ? sel.getRangeAt(0).cloneRange() : null;
    editingA = savedRange ? anchorFrom(savedRange.commonAncestorContainer) : null;
    linkTitle.textContent = editingA ? 'Edit link' : 'Insert link';
    linkRemove.hidden = !editingA;
    linkUrl.value = editingA ? (editingA.getAttribute('href') || '') : '';
    var txt = editingA ? editingA.textContent : (savedRange && !savedRange.collapsed ? savedRange.toString() : '');
    linkHint.textContent = txt ? 'Link text: “' + txt + '”' : 'No text selected — the URL itself becomes the link text.';
    linkDlg.showModal();
    linkUrl.focus(); linkUrl.select();
  }
  // Leave explicit schemes, relative paths, queries and anchors alone; a bare
  // domain ("example.com/x") gets https:// so it doesn't become a broken
  // relative link.
  function normalizeUrl(u){
    if(/^([a-z][a-z0-9+.-]*:|[\/#?])/i.test(u)) return u;
    return /^[^\s\/]+\.[^\s]+$/.test(u) ? 'https://' + u : u;
  }
  function removeLinkNow(){
    focusEdit();
    if(editingA){
      var r = doc.createRange(); r.selectNodeContents(editingA);
      var sel = doc.getSelection(); sel.removeAllRanges(); sel.addRange(r);
    }
    exec('unlink');
  }
  function applyLink(){
    var u = normalizeUrl(linkUrl.value.trim());
    linkDlg.close();
    if(!u){ if(editingA) removeLinkNow(); return; }
    focusEdit();
    if(editingA){ editingA.setAttribute('href', u); sync(); return; }
    var sel = doc.getSelection();
    if(savedRange){ sel.removeAllRanges(); sel.addRange(savedRange); }
    if(savedRange && !savedRange.collapsed){ exec('createLink', u); return; }
    var esc = escHtml(u);
    try { doc.execCommand('insertHTML', false, '<a href="' + esc + '">' + esc + '</a>'); } catch(e){}
    resolveImages(); sync();
  }
  if(linkApply) linkApply.addEventListener('click', applyLink);
  if(linkRemove) linkRemove.addEventListener('click', function(){ linkDlg.close(); removeLinkNow(); });
  if(linkUrl) linkUrl.addEventListener('keydown', function(e){ if(e.key === 'Enter'){ e.preventDefault(); applyLink(); } });

  // Double-clicking a link in the editor opens the same modal on that link.
  edit.addEventListener('dblclick', function(e){
    var a = anchorFrom(e.target);
    if(!a) return;
    e.preventDefault();
    var r = doc.createRange(); r.selectNodeContents(a);
    var sel = doc.getSelection(); sel.removeAllRanges(); sel.addRange(r);
    openLinkModal();
  });

  function focusEdit(){ try{ frame.contentWindow.focus(); }catch(e){} edit.focus(); }
  function exec(cmd, val){ focusEdit(); try{ doc.execCommand(cmd, false, val || null); }catch(e){} resolveImages(); sync(); }
  function insertHTML(html){
    focusEdit();
    var ok = false;
    try { ok = doc.execCommand('insertHTML', false, html); } catch(e){}
    if(!ok){ edit.insertAdjacentHTML('beforeend', html); }
    resolveImages(); sync();
  }

  toolbar.addEventListener('click', function(ev){
    var b = ev.target.closest('button'); if(!b) return;
    ev.preventDefault();
    if(b.hasAttribute('data-cmd')) return exec(b.getAttribute('data-cmd'));
    if(b.hasAttribute('data-block')) return exec('formatBlock', b.getAttribute('data-block'));
    if(b.hasAttribute('data-link')){ openLinkModal(); return; }
    if(b.hasAttribute('data-img')){
      var id = prompt('Media id (from the Media library):', '');
      if(id){ var alt = prompt('Alt text (required for images):', '') || '';
        insertHTML('<img data-media-id="' + String(id).replace(/[^0-9]/g,'') + '" alt="' + alt.replace(/"/g,'&quot;') + '">'); }
      return;
    }
    if(b.hasAttribute('data-source')){
      if(typeof CodeMirror !== 'undefined'){ split ? closeSplit(b) : openSplit(b); }
      else toggleSource(b);
      return;
    }
  });

  var comp = toolbar.querySelector('.wy-comp');
  if(comp){ comp.addEventListener('change', function(){
    var h = comp.value; comp.value = '';
    if(h) insertHTML('<div data-fs-component="' + h.replace(/[^A-Za-z0-9_-]/g,'') + '" data-values="{}"></div>');
  }); }

  // ---- Source split view. The designer stays live on the left, CodeMirror
  // on the right (same local bundle + look as the Site-Settings shell editor).
  // Edits flow both ways, debounced; whichever pane was edited last wins on
  // save. toggleSource below stays as the no-CodeMirror fallback.
  function initCm(){
    if(cm !== null || typeof CodeMirror === 'undefined') return;
    cm = CodeMirror.fromTextArea(ta, {
      mode: 'htmlmixed', lineNumbers: true, lineWrapping: true,
      indentUnit: 2, tabSize: 2, indentWithTabs: false,
      matchBrackets: true, autoCloseBrackets: true, styleActiveLine: true
    });
    cm.on('change', function(){
      if(muteCm) return;
      lastEdited = 'source';
      ta.value = cm.getValue();
      clearTimeout(edPushTimer);
      edPushTimer = setTimeout(function(){
        edPushTimer = null;
        edit.innerHTML = cm.getValue(); resolveImages();
      }, 600);
    });
  }
  function flushSource(){
    if(edPushTimer){ clearTimeout(edPushTimer); edPushTimer = null; edit.innerHTML = cm.getValue(); resolveImages(); }
  }
  function openSplit(btn){
    initCm();
    if(cm === null){ toggleSource(btn); return; }
    split = true; root.classList.add('split');
    muteCm = true; cm.setValue(cleanHtml()); muteCm = false;
    cm.refresh();
    lastEdited = 'editor';
    btn.classList.add('on');
  }
  function closeSplit(btn){
    flushSource();
    split = false; root.classList.remove('split');
    btn.classList.remove('on');
    sync();
  }

  // ---- Designer → source mapping: click, select or scroll in the designer
  // and the source pane selects/scrolls to the same spot. Offsets are computed
  // by walking the DOM exactly the way innerHTML serialises it (including
  // cleanHtml's img-src stripping), so they are character-accurate against the
  // source text; if the panes have drifted mid-edit it falls back to a
  // unique-substring search for the clicked element.
  var serBox = null;
  function cleanCopy(node){
    var c = node.cloneNode(true);
    if(c.nodeType === 1){
      var imgs = (c.matches && c.matches('img[data-media-id]')) ? [c] : [];
      if(c.querySelectorAll) imgs = imgs.concat([].slice.call(c.querySelectorAll('img[data-media-id]')));
      for(var i=0;i<imgs.length;i++){ imgs[i].removeAttribute('src'); imgs[i].removeAttribute('loading'); }
    }
    return c;
  }
  function serialize(node){
    serBox = serBox || doc.createElement('div');
    serBox.textContent = '';
    serBox.appendChild(cleanCopy(node));
    return serBox.innerHTML;
  }
  function escLen(text){
    serBox = serBox || doc.createElement('div');
    serBox.textContent = text;
    return serBox.innerHTML.length;
  }
  function openTagLen(el){
    // outer = open tag + inner + close tag; ancestors of a target are never void.
    return serialize(el).length - cleanCopy(el).innerHTML.length - (el.tagName.length + 3);
  }
  function nodeStart(target){
    var pos = 0, parent = edit;
    for(;;){
      var kids = parent.childNodes, descend = null;
      for(var i = 0; i < kids.length; i++){
        var k = kids[i];
        if(k === target) return pos;
        if(k.nodeType === 1 && k.contains(target)){ pos += openTagLen(k); descend = k; break; }
        pos += serialize(k).length;
      }
      if(!descend) return -1;
      parent = descend;
    }
  }
  function boundaryOffset(container, offset){
    if(container.nodeType === 3){
      var s = nodeStart(container);
      return s < 0 ? -1 : s + escLen(container.data.slice(0, offset));
    }
    if(container.nodeType !== 1 || (container !== edit && !edit.contains(container))) return -1;
    if(offset < container.childNodes.length){
      return container === edit && offset === 0 ? 0 : nodeStart(container.childNodes[offset]);
    }
    if(container === edit) return cleanHtml().length;
    var st = nodeStart(container);
    return st < 0 ? -1 : st + openTagLen(container) + cleanCopy(container).innerHTML.length;
  }
  function mapSelectionToSource(){
    if(!split || cm === null || cm.hasFocus()) return;
    var sel = doc.getSelection();
    if(!sel || !sel.rangeCount) return;
    var r = sel.getRangeAt(0);
    if(r.startContainer !== edit && !edit.contains(r.startContainer)) return;
    if(cm.getValue() === cleanHtml()){
      var a = boundaryOffset(r.startContainer, r.startOffset);
      var b = r.collapsed ? a : boundaryOffset(r.endContainer, r.endOffset);
      if(a < 0 || b < 0) return;
      var from = cm.posFromIndex(Math.min(a, b)), to = cm.posFromIndex(Math.max(a, b));
      cm.setSelection(from, to, {scroll: false});
      cm.scrollIntoView({from: from, to: to}, 80);
      return;
    }
    var el = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentNode;
    if(!el || el === edit || !edit.contains(el)) return;
    var snip = serialize(el), txt = cm.getValue();
    var idx = txt.indexOf(snip);
    if(idx < 0 || txt.indexOf(snip, idx + 1) >= 0) return;
    var f = cm.posFromIndex(idx), t = cm.posFromIndex(idx + snip.length);
    cm.setSelection(f, t, {scroll: false});
    cm.scrollIntoView({from: f, to: t}, 80);
  }
  function queueMap(){ if(!split) return; clearTimeout(mapTimer); mapTimer = setTimeout(mapSelectionToSource, 80); }
  doc.addEventListener('mouseup', queueMap);
  doc.addEventListener('keyup', function(e){ if(/^(Arrow|Home$|End$|Page)/.test(e.key)) queueMap(); });
  doc.addEventListener('scroll', function(){
    if(!split || cm === null || cm.hasFocus()) return;
    var se = doc.scrollingElement || doc.documentElement;
    var max = se.scrollHeight - se.clientHeight;
    if(max <= 0) return;
    var si = cm.getScrollInfo();
    cm.scrollTo(null, (se.scrollTop / max) * Math.max(0, si.height - si.clientHeight));
  }, {passive: true});

  function toggleSource(btn){
    sourceMode = !sourceMode;
    if(sourceMode){
      ta.value = cleanHtml(); ta.style.display = ''; frame.hidden = true;
      btn.classList.add('on'); btn.textContent = 'Editor';
    } else {
      edit.innerHTML = ta.value; resolveImages();
      ta.style.display = 'none'; frame.hidden = false;
      btn.classList.remove('on'); btn.textContent = 'Source';
    }
  }

  var form = root.closest('form');
  if(form) form.addEventListener('submit', function(){
    if(cm !== null){
      // CodeMirror's fromTextArea registers its own submit hook that copies
      // the CM text into the textarea AFTER this listener — so make the CM
      // text the truth: designer-last serialises the designer into it,
      // source-last keeps the hand-written source verbatim.
      if(lastEdited === 'editor'){ muteCm = true; cm.setValue(cleanHtml()); muteCm = false; }
      ta.value = cm.getValue();
      return;
    }
    if(!sourceMode) ta.value = cleanHtml();
  });
})();
</script>
{% endblock %}
