{% extends 'layout.html.twig' %}

{% block body %}
{% if challenge %}
  <h1>Two-factor code</h1>
  <p class="sub">Enter the 6-digit code from your authenticator app.</p>
  {% if error %}<div class="error">{{ error }}</div>{% endif %}
  <form method="post" action="/oauth/login">
    <input type="hidden" name="return" value="{{ return_to }}">
    <input type="hidden" name="challenge" value="{{ challenge }}">
    <label for="code">Code</label>
    <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required autofocus>
    <button type="submit" class="button">Verify</button>
  </form>
{% else %}
  <h1>Sign in</h1>
  <p class="sub">to continue to <strong>{{ client_name }}</strong></p>
  {% if error %}<div class="error">{{ error }}</div>{% endif %}
  <form method="post" action="/oauth/login">
    <input type="hidden" name="return" value="{{ return_to }}">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" autocomplete="username" required autofocus>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>
    <button type="submit" class="button">Sign in</button>
  </form>
  <p class="foot">Use your fastsite account credentials.</p>
{% endif %}
{% endblock %}
