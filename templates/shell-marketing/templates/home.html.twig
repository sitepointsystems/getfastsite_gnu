{% extends 'base.html.twig' %}

{% block main %}
{% if content is defined and content.body_html %}
{# An authored page with slug "home" overrides the designed landing. #}
{{ content.body_html|raw }}
{% else %}

<section class="hero">
  <div class="wrap">
    <span class="eyebrow">Static publishing engine · not a CMS</span>
    <h1>Ship sites that score <span class="grad">100/100/100/100</span> with zero JavaScript.</h1>
    <p class="lede">Send content in over REST, a webhook, or MCP. fastsite renders fully static HTML, commits it per site, and deploys to your CDN. Every page is fast, accessible, and SEO-clean by construction.</p>
    <div class="button-row" style="justify-content:center">
      <a class="button" href="/how-it-works/">See how it works</a>
      <a class="button ghost" href="/api/">Explore the API &amp; MCP</a>
    </div>
    <div class="stats">
      <div class="stat"><div class="n green">100</div><div class="l">PageSpeed, every page</div></div>
      <div class="stat"><div class="n">0&nbsp;KB</div><div class="l">JavaScript shipped</div></div>
      <div class="stat"><div class="n">1&nbsp;commit</div><div class="l">per publish, per site</div></div>
      <div class="stat"><div class="n green">AVIF</div><div class="l">+ WebP, auto-generated</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="center" style="max-width:44rem;margin:0 auto 2.5rem">
      <p class="eyebrow-2">Three ways in, one way out</p>
      <h2>Content goes in. Static HTML comes out.</h2>
      <p class="lead">No page builder, no runtime, no database on the edge. The engine is the build step — your visitors only ever get pre-rendered files.</p>
    </div>
    <div class="grid">
      <div class="card"><span class="ico">🔌</span><h3>REST API</h3><p>A clean, scoped, idempotent JSON API. Create posts and pages, upload media, manage the shell — everything the dashboard does.</p></div>
      <div class="card"><span class="ico">🤖</span><h3>MCP server</h3><p>Native Model Context Protocol. Point Claude or any MCP client at your site and let it author, translate, and publish — with OAuth consent and per-scope control.</p></div>
      <div class="card"><span class="ico">🪝</span><h3>Webhooks</h3><p>HMAC-signed inbound webhooks map any payload to a post, page, media import, or component. Wire up your pipeline and forget it.</p></div>
      <div class="card"><span class="ico">🖼️</span><h3>Automatic images</h3><p>Every upload becomes AVIF + WebP at five widths plus an OG crop, EXIF-stripped, dimensioned, and lazy-loaded. Alt text enforced.</p></div>
      <div class="card"><span class="ico">🌍</span><h3>Auto-translation</h3><p>Add a locale and the engine translates published content and UI strings, emits per-language trees with correct hreflang, and keeps them in sync.</p></div>
      <div class="card"><span class="ico">🧩</span><h3>Components</h3><p>Author HTML fragments or React components. React is compiled to static markup at build — interactive authoring, zero shipped JS.</p></div>
    </div>
  </div>
</section>

<section class="section" style="background:var(--bg-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="wrap">
    <div class="split">
      <div>
        <p class="eyebrow-2">The whole flow</p>
        <h2>From one API call to a live, cached page.</h2>
        <div class="prose-lite">
          <p>You send HTML bodies — the engine owns everything else: sanitizing, image expansion, SEO head, sitemaps, <code>robots.txt</code>, <code>llms.txt</code>, canonical URLs, and an incremental build that only rewrites what changed.</p>
          <p>Output is committed to your git repo, one commit per publish, and served by Cloudflare Pages. Your database never touches the edge.</p>
        </div>
        <ul class="pills">
          <li><b>✓</b> Sanitized on every ingest</li>
          <li><b>✓</b> Sitemaps + hreflang</li>
          <li><b>✓</b> Immutable caching headers</li>
          <li><b>✓</b> Pre-push secret scan</li>
        </ul>
      </div>
      <div class="terminal" aria-hidden="false">
        <div class="bar"><i></i><i></i><i></i><span class="t">create a post over REST</span></div>
<pre><code><span class="tok-c"># POST a body — get back a slug, then publish</span>
curl -X POST https://your-host/api/v1/sites/blog/content \
  -H <span class="tok-s">"X-API-Key: $FASTSITE_KEY"</span> \
  -H <span class="tok-s">"Content-Type: application/json"</span> \
  -d <span class="tok-s">'{"type":"post","title":"Hello",
       "body_html":"&lt;p&gt;Shipped in one call.&lt;/p&gt;",
       "status":"published"}'</span>

curl -X POST https://your-host/api/v1/sites/blog/publish \
  -H <span class="tok-s">"X-API-Key: $FASTSITE_KEY"</span>

<span class="tok-c"># → a static /blog/hello/ appears,</span>
<span class="tok-c">#   committed to git and live on the CDN.</span></code></pre>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="center" style="max-width:40rem;margin:0 auto 2.5rem">
      <p class="eyebrow-2">How it works</p>
      <h2>Four steps, fully automated.</h2>
    </div>
    <div class="steps">
      <div class="step"><h3>Send content</h3><p>REST, webhook, or MCP. Bodies are HTML; the engine sanitizes and stores them in per-site SQLite.</p></div>
      <div class="step"><h3>Build static HTML</h3><p>Twig shell + tokens, inlined minified CSS, images expanded to <code>&lt;picture&gt;</code>, zero JS. A per-build audit blocks anything that would cost a point.</p></div>
      <div class="step"><h3>Commit per site</h3><p>Only changed files are written. The dist is committed to your repo — a clean, reviewable history of every publish.</p></div>
      <div class="step"><h3>Serve from the edge</h3><p>Cloudflare Pages picks up the commit. Your readers get pre-rendered, immutably-cached files.</p></div>
    </div>
  </div>
</section>

<section class="section tight">
  <div class="wrap">
    <div class="band">
      <p class="eyebrow-2">Built for humans and agents</p>
      <h2>Design the shell once. Let agents fill it forever.</h2>
      <p>Teams, per-user GitHub credentials, soft-delete trash, redirects, header/footer scripts, a WYSIWYG editor, backup and restore — all on the dashboard, all on the API, all on MCP.</p>
      <div class="button-row" style="justify-content:center">
        <a class="button alt" href="/how-it-works/">Start with the guide</a>
        <a class="button ghost" href="/api/">Read the API reference</a>
      </div>
    </div>
  </div>
</section>

{% if posts %}
<section class="section">
  <div class="wrap">
    <h2>{{ t('latest_posts') }}</h2>
    <div class="cards">
      {% for post in posts %}
      <article class="card">
        <h3><a href="{{ post.url }}">{{ post.title }}</a></h3>
        {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
        {% if post.published_at %}<time datetime="{{ post.published_at }}">{{ post.published_at|date('M j, Y') }}</time>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% endif %}
{% endblock %}
