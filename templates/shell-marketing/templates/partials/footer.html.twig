<footer class="site-footer">
  <div class="wrap">
    <div>
      <p class="brand" style="font-size:1rem">{% if site.logo_footer_url %}<img src="{{ site.logo_footer_url }}" alt="{{ site.name }}" height="26">{% else %}<span class="spark"></span>{{ site.name }}{% endif %}</p>
      <p class="fine">{{ t('footer_tagline') }}</p>
    </div>
    <nav aria-label="Footer">
      <a href="/how-it-works/">{{ t('nav_how') }}</a>
      <a href="/api/">{{ t('nav_api') }}</a>
      <a href="/webhooks/">{{ t('nav_webhooks') }}</a>
      <a href="/blog/">{{ t('blog') }}</a>
    </nav>
  </div>
  <div class="wrap" style="margin-top:1.5rem">
    <p class="fine">&copy; {{ "now"|date("Y") }} {{ site.name }}. {{ t('footer_built_with') }}</p>
  </div>
</footer>
