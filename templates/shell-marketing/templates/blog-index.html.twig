{% extends 'base.html.twig' %}

{% block main %}
<section class="section">
  <div class="wrap">
    <header style="max-width:44rem;margin:0 0 1rem">
      <p class="eyebrow-2">{{ t('blog') }}</p>
      <h1>{{ t('blog_title') }}</h1>
      <p class="lead">{{ t('blog_intro') }}</p>
    </header>
    {% if posts %}
    <div class="cards">
      {% for post in posts %}
      <article class="card">
        {% if post.featured_thumb %}<a class="card-media" href="{{ post.url }}">{{ post.featured_thumb|raw }}</a>{% endif %}
        <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
        {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
        {% if post.published_at %}<time datetime="{{ post.published_at }}">{{ post.published_at|date('M j, Y') }}</time>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted">{{ t('no_posts_yet') }}</p>
    {% endif %}
  </div>
</section>
{% endblock %}
